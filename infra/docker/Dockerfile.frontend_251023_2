# =========================================================
#  FRONTEND (Next.js 14)
# =========================================================

# 1️⃣ 빌드 스테이지
FROM node:20-slim AS builder

# 작업 디렉토리 설정
WORKDIR /app

# 환경 변수 (Next.js가 필요한 시스템 변수 설정)
# ENV NODE_ENV=production
ENV NODE_ENV=development

# 종속성 캐시 최적화
COPY ./frontend/package*.json ./
COPY ../.env ./.env

# 의존성 설치 (npm ci는 lock 기반 설치로 더 안전함)
# RUN npm ci
RUN npm install

# 전체 소스 복사 및 Next.js 빌드
COPY ./frontend .
RUN npm run build

# 2️⃣ 런타임 스테이지 (경량화된 런타임 이미지로 옮김)
FROM node:20-slim AS runner
WORKDIR /app

ENV NODE_ENV=production \
    PORT=3000

# 필요한 파일만 복사 (경량화)
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

# 포트 개방 (Next.js의 이미지 최적화 등 정적 파일 제공용 포트)
EXPOSE 3000

# 10. Next.js 시작 (환경별 분기 실행 명령)
CMD [ "sh", "-c", "\
    if [ \"$NODE_ENV\" = 'development' ]; then \
        echo '🚀 [FRONTEND DEV] Running next dev...'; \
        npm run dev; \
    else \
        echo '🔥 [FRONTEND PROD] Running next start...'; \
        npm run start; \
    fi" ]
