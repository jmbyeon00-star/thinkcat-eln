# =========================================================
#  GPU Backend (CUDA 12.4 + Ubuntu 22.04 + FastAPI)
# =========================================================
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

WORKDIR /app
ENV DEBIAN_FRONTEND=noninteractive TZ=Asia/Seoul
# -------------------------------
#  시스템 패키지 설치
# -------------------------------
RUN rm -rf /var/lib/apt/lists/* && apt-get clean && \
    apt-get update --allow-releaseinfo-change && \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
        build-essential \
        git \
        curl \
        ca-certificates \
        gnupg \
        ubuntu-keyring \
        tzdata && \
    rm -rf /var/lib/apt/lists/*

# -------------------------------
#  Python 환경 설정
# -------------------------------
ENV PYTHONUNBUFFERED=1 \
    TZ=Asia/Seoul \
    ENV=prod

# -------------------------------
# Python 패키지 설치
# -------------------------------
COPY ./gpu_backend/requirements.txt /app/requirements.txt
RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install --no-cache-dir -r requirements.txt

# -------------------------------
# 앱 코드 복사
# -------------------------------
COPY ./gpu_backend/app /app/app

EXPOSE 8000

# -------------------------------
#  실행 명령 (환경별 분기)
# -------------------------------
CMD [ "sh", "-c", "\
    if [ \"$ENV\" = 'dev' ]; then \
        echo '🚀 [GPU DEV MODE] FastAPI running (no reload)...'; \
        uvicorn app.main:app --host 0.0.0.0 --port 8000; \
    else \
        echo '🔥 [GPU PROD MODE] FastAPI running with 2 workers...'; \
        uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2; \
    fi" ]
