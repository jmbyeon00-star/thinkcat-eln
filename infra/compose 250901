version: "3.9"

services:
  backend:
    build:
      context: ..
      dockerfile: /home2/yckim/development/ipforce_next/infra/docker/Dockerfile.backend
    container_name: ipforce_backend
    env_file:
      - ../.env
    environment:
      ENV: "dev"
      API_BASE_URL: "http://backend:8000"
    ports:
      - "8000:8000"
    volumes:
      - ../backend:/app
    command: >
      uvicorn app.main:app
      --host 0.0.0.0 --port 8000
      --reload --reload-dir /app
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/healthz"]
      interval: 5s
      timeout: 3s
      retries: 10

  frontend:
    build:
      context: ..
      dockerfile: /home2/yckim/development/ipforce_next/infra/docker/Dockerfile.frontend
    container_name: ipforce_frontend
    env_file:
      - ../.env
    environment:
      NEXT_PUBLIC_API_BASE_URL: "http://localhost:8000"
      WATCHPACK_POLLING: "true"
    ports:
      - "3000:3000"
    working_dir: /app
    volumes:
      - /home2/yckim/development/ipforce_next:/app
    command: sh -c "cd frontend && npm install && npm run dev -- -p 3000 -H 0.0.0.0"
    depends_on:
      backend:
        condition: service_healthy
