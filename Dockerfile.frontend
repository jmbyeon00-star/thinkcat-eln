# ────────────────────────────────
# 1. 빌드 단계
# ────────────────────────────────
FROM node:20-slim AS builder

# 작업 디렉토리 설정
WORKDIR /app

# 종속성 설치 package.json / lock 파일 복사 (캐시 효율 향상)
COPY ./frontend/package*.json ./
COPY ../.env ./.env

# 의존성 설치 (개발 환경에선 npm install, 배포 시 npm ci 권장)
RUN npm install

# 전체 소스 복사
COPY ./frontend .

# Next.js 빌드 (빌드 시 .env는 프론트엔드용 NEXT_PUBLIC_* 만 사용됨)
RUN npm run build


# ────────────────────────────────
# 2. 런타임 단계
# ────────────────────────────────
FROM node:20-slim AS runner

# 환경 설정
ENV NODE_ENV=production

# 작업 디렉토리
WORKDIR /app

# 빌드 산출물 복사
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

# 포트 개방
EXPOSE 3000

# 기본 실행 명령
CMD ["npm", "run", "start"]
