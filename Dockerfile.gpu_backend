# ────────────────────────────────
# 1. CUDA + Ubuntu 베이스 이미지
# ────────────────────────────────
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

# 작업 디렉토리
WORKDIR /app

# ────────────────────────────────
# 2. 시스템 패키지 설치 (개발용 최소 구성)
# ────────────────────────────────
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
        build-essential \
        git \
        curl \
        ca-certificates \
        gnupg \
        ubuntu-keyring && \
    rm -rf /var/lib/apt/lists/*

# ────────────────────────────────
# 3. Python 패키지 설치
# ────────────────────────────────
RUN python3 -m pip install --upgrade pip setuptools
COPY ./gpu_backend/requirements.txt ./requirements.txt
RUN python3 -m pip install --no-cache-dir -r requirements.txt

# ────────────────────────────────
# 4. 앱 소스 복사
# ────────────────────────────────
COPY ./gpu_backend/app /app

# ────────────────────────────────
# 5. 환경 변수
# ────────────────────────────────
ENV PYTHONUNBUFFERED=1 \
    TZ=Asia/Seoul \
    ENV=dev

# ────────────────────────────────
# 6. 포트 및 실행
# ────────────────────────────────
EXPOSE 8008
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8008", "--reload", "--reload-dir", "/app"]