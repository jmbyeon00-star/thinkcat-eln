// 사용 예시
export default function ExampleUsage({ loading, collection, error }: any) {
  if (loading) {
    return <LoadingState />;
  }

  if (error) {
    return <ErrorState message={error} />;
  }

  if (!collection) {
    return <NoDataState />;
  }

  return <div>데이터 표시</div>;
}