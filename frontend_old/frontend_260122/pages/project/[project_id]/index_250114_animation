                            </div>
                        </div>
                        <style jsx>{`
                        @keyframes dash { to { stroke-dashoffset: -24; } }
                    `}</style>
                        <style jsx>{`
                        @keyframes dash {
                            from { stroke-dashoffset: 28; }
                            to { stroke-dashoffset: 0; }
                        }
                    `}</style>
                    </div>
                )}
