    const [loading, setLoading] = useState(true);

    // >>> 프로젝트 구조 도형 노드 관련 로직
    // 1. 로직 부분: 실시간 추적 및 좌표 정밀 계산
    const names = useMemo(() => ["A", "B", "C", "D", "E", "A", "B", "C", "D", "E", "A", "B", "C", "D", "E", "A", "B", "C", "D", "E", "A", "B", "C", "D", "E", "A", "B", "C", "D", "E", "A", "B", "C", "D", "E",], []);
    const [hoverIndex, setHoverIndex] = useState<number | null>(null);
    const wrapRef = useRef<HTMLDivElement | null>(null);
    const projectRef = useRef<HTMLDivElement | null>(null);
    const nodeRefs = useRef<(HTMLDivElement | null)[]>([]);
    const [paths, setPaths] = useState<string[]>([]);

    // 1. 로직: 단순화 (스크롤과 리사이즈 시에만 반응)
    const buildPaths = useCallback(() => {
        // 렌더링 최적화를 위해 rAF 사용
        window.requestAnimationFrame(() => {
            if (!wrapRef.current || !projectRef.current) return;

            const wrapRect = wrapRef.current.getBoundingClientRect();
            const pRect = projectRef.current.getBoundingClientRect();

            // 상단 프로젝트 노드 하단 중앙
            const pX = pRect.left - wrapRect.left + pRect.width / 2;
            const pY = pRect.bottom - wrapRect.top;

            const next = nodeRefs.current.map((el) => {
                if (!el) return "";
                const r = el.getBoundingClientRect();

                const cX = r.left - wrapRect.left + r.width / 2;
                const cY = r.top - wrapRect.top;

                // 곡률 계산 (단순화)
                const midY = pY + (cY - pY) * 0.5;
                return `M ${pX} ${pY} C ${pX} ${midY}, ${cX} ${midY}, ${cX} ${cY}`;
            });
            setPaths(next);
        });
    }, []);

    // 렉의 주범이었던 setInterval을 제거하고 ResizeObserver만 사용
    useLayoutEffect(() => {
        buildPaths();

        const ro = new ResizeObserver(() => {
            buildPaths();
        });

        if (wrapRef.current) ro.observe(wrapRef.current);
        // 각 노드들의 위치 변화 감지 (호버 시 translate 이동 감지)
        nodeRefs.current.forEach(n => n && ro.observe(n));

        window.addEventListener("resize", buildPaths);
        return () => {
            window.removeEventListener("resize", buildPaths);
            ro.disconnect();
        };
    }, [buildPaths, names]);
    // <<<

    // href = { projectInfo && projectInfo.collection_num ?
    //     `/project/${projectInfo.id}/models/new?collection_num=${projectInfo.collection_num}&task_type=${projectInfo.task_type}&source_type=${projectInfo.source_type}` :
    //     projectInfo && !projectInfo.collection_num ?
    //         `/project/${projectInfo.id}/collection` :
    //         "#"
    // }
    console.log("projectInfo:", projectInfo)

    useEffect(() => {
        if (!project_id || !token) return;

        let cancelled = false;

        async function loadPreview() {
            setLoading(true);
            try {
                const res = await api.get(`/api/project/${project_id}/detail`, {
                    headers: authHeader(token),
                });

                const data = res.data;

                if (!cancelled) {
                    setProjectInfo(data.project_info || null);
                    setModels(data.models || []);
                }
            } catch (e) {
                console.error("데이터 로딩 오류:", e);
            } finally {
                setLoading(false);
            }
        }

        loadPreview();
        return () => {
            cancelled = true;
        };
    }, [project_id, token]);

