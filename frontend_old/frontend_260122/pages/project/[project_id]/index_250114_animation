            ${hoverIndex === idx ? "border-blue-500 shadow-blue-100 shadow-2xl -translate-y-2" : "border-zinc-200"}`}>
                                            <div className="flex items-center justify-center gap-2 mb-2">
                                                <div className={`w-2 h-2 rounded-full ${hoverIndex === idx ? "bg-blue-500 animate-pulse" : "bg-zinc-300"}`} />
                                                <span className="text-[10px] font-bold text-zinc-400 uppercase">Collection</span>
