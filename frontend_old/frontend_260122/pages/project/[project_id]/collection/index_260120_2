import { useEffect, useState, useMemo, useCallback } from "react";
import { useRouter } from "next/router";
import { useSession } from "next-auth/react";
import { Session } from "next-auth";
import {
  Folder, Database, FileText, Search, LayoutGrid, Table,
  ChevronLeft, ChevronRight, BarChart3, PieChart as PieChartIcon,
  BarChart2, Plus, XCircle, Loader2, Eye, List
} from "lucide-react";
import {
  PieChart, Pie, Cell, Tooltip, ResponsiveContainer, Legend,
  BarChart, Bar, XAxis, YAxis, CartesianGrid
} from "recharts";

import ProjectLayout from "@/components/layouts/ProjectLayout";
import AddCollectionModal from "@/components/collection/AddCollectionModal";
import { useCollectionActions } from "@/hooks/project/useCollectionActions";
import { withMessages } from '@/lib/i18n/withMessages';
import { CollectionInfo } from "@/types/collection";
import { ProjectInfo } from "@/types/project";
import { ModelInfo } from "@/lib/types";

export const getServerSideProps = withMessages();

const COLORS = ['#0088FE', '#00C49F', '#FFBB28', '#FF8042', '#AF19FF', '#FF19A6', '#19FFD1', '#5B86E5', '#A52A2A', '#004D40'];

export default function CombinedCollectionPage() {
  const router = useRouter();
  const { project_id } = router.query;
  const API_BASE = process.env.NEXT_PUBLIC_API_BASE_URL;

  const { data: session } = useSession() as {
    data: (Session & { access_token?: string }) | null;
  };
  const token = session?.access_token;

  // UI 상태
  const [viewMode, setViewMode] = useState<"grid" | "table" | "stats">("grid");
  const [chartType, setChartType] = useState<'bar' | 'pie'>('bar');
  const [isAddModalOpen, setIsAddModalOpen] = useState(false);

  // 데이터 상태
  const [collections, setCollections] = useState<CollectionInfo[]>([]);
  const [projectInfo, setProjectInfo] = useState<ProjectInfo | null>(null);
  const [modelInfo, setModelInfo] = useState<ModelInfo | null>(null);
  const [loading, setLoading] = useState(true);
  const [query, setQuery] = useState("");
  const [page, setPage] = useState(1);
  const [limit] = useState(6);
  const [total, setTotal] = useState(0);
  const [totalDataNum, setTotalDataNum] = useState(0);

  // 체크박스 선택 상태 (ID와 Code를 함께 관리)
  const [selectedCollections, setSelectedCollections] = useState<{ id: number, code: string }[]>([]);

  // 데이터 로딩 함수
  const loadCollections = useCallback(async () => {
    if (!project_id || !token) return;

    try {
      setLoading(true);
      // 통합된 정보를 가져오기 위해 두 번째 페이지에서 사용하던 엔드포인트 활용 권장
      const res = await fetch(
        `${API_BASE}/api/project/${project_id}/collection?page=${page}&limit=${limit}&q=${encodeURIComponent(query)}`,
        { headers: { Authorization: `Bearer ${token}` } }
      );
      const data = await res.json();

      setCollections(data.collection_info || []);
      setProjectInfo(data.project_info);
      setModelInfo(data.model_info);
      setTotal(data.total_collections || 0);
      setTotalDataNum(data.total_data_num || 0);
    } catch (e) {
      console.error("데이터 로드 실패:", e);
    } finally {
      setLoading(false);
    }
  }, [project_id, token, page, limit, query, API_BASE]);

  useEffect(() => {
    const debounce = setTimeout(loadCollections, 300);
    return () => clearTimeout(debounce);
  }, [loadCollections]);

  // 커스텀 훅 사용 (추가/삭제 로직)
  const { addCollection, deleteCollections, isActionLoading } = useCollectionActions(
    project_id as string,
    token,
    loadCollections
  );

  // --- 핸들러 함수들 ---
  const handleSelectAll = () => {
    if (selectedCollections.length === collections.length) {
      setSelectedCollections([]);
    } else {
      setSelectedCollections(collections.map(c => ({ id: c.id, code: c.collection_code })));
    }
  };

  const handleSelectOne = (id: number, code: string) => {
    setSelectedCollections(prev => {
      const isSelected = prev.some(item => item.id === id);
      return isSelected ? prev.filter(item => item.id !== id) : [...prev, { id, code }];
    });
  };

  const handleDeleteSelected = async () => {
    if (selectedCollections.length === 0) return;
    if (!confirm(`선택한 ${selectedCollections.length}개의 컬렉션을 삭제하시겠습니까?`)) return;

    const success = await deleteCollections(selectedCollections);
    if (success) {
      setSelectedCollections([]);
      alert("삭제되었습니다.");
    }
  };

  const handleAnalyze = () => {
    if (selectedCollections.length === 0) {
      alert("분석할 컬렉션을 선택해주세요.");
      return;
    }
    const codes = selectedCollections.map(s => s.code).join(',');
    router.push(`/project/${project_id}/collection/analysis?codes=${codes}`);
  };

  const hasModel = useMemo(() => {
    if (Array.isArray(modelInfo)) return modelInfo.length > 0;
    return !!modelInfo;
  }, [modelInfo]);

  // 차트 데이터 가공
  const chartData = useMemo(() => {
    if (!collections || totalDataNum === 0) return [];
    return [...collections]
      .sort((a, b) => (b.collection_data_num || 0) - (a.collection_data_num || 0))
      .slice(0, 10)
      .map((col, index) => ({
        name: col.collection_name,
        value: col.collection_data_num || 0,
        ratio: col.calculated_ratio ?? ((col.collection_data_num || 0) / totalDataNum) * 100,
        color: COLORS[index % COLORS.length]
      }));
  }, [collections, totalDataNum]);

  // --- 렌더링 서브 컴포넌트 ---
  const renderStatsView = () => (
    <div className="space-y-6 animate-in fade-in duration-500">
      <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div className="bg-blue-50 border-l-4 border-blue-600 p-6 rounded-xl shadow-sm">
          <p className="text-sm font-medium text-blue-600">전체 컬렉션</p>
          <p className="text-3xl font-bold text-zinc-900">{total}개</p>
        </div>
        <div className="bg-indigo-50 border-l-4 border-indigo-600 p-6 rounded-xl shadow-sm">
          <p className="text-sm font-medium text-indigo-600">총 데이터 수</p>
          <p className="text-3xl font-bold text-zinc-900">{totalDataNum.toLocaleString()}건</p>
        </div>
        <div className="bg-emerald-50 border-l-4 border-emerald-600 p-6 rounded-xl shadow-sm">
          <p className="text-sm font-medium text-emerald-600">학습 모델 상태</p>
          <p className="text-xl font-bold text-zinc-900">{hasModel ? "보유 (편집제한)" : "미보유"}</p>
        </div>
      </div>

      <div className="bg-white border border-zinc-200 p-6 rounded-2xl shadow-sm">
        <div className="flex justify-between items-center mb-6">
          <h3 className="text-lg font-bold flex items-center gap-2">
            <BarChart3 className="w-5 h-5 text-blue-600" /> 데이터 분포 (Top 10)
          </h3>
          <div className="flex gap-2 bg-zinc-100 p-1 rounded-lg">
            <button onClick={() => setChartType('bar')} className={`px-3 py-1.5 text-xs font-medium rounded-md transition ${chartType === 'bar' ? 'bg-white shadow-sm text-blue-600' : 'text-zinc-500'}`}>막대</button>
            <button onClick={() => setChartType('pie')} className={`px-3 py-1.5 text-xs font-medium rounded-md transition ${chartType === 'pie' ? 'bg-white shadow-sm text-blue-600' : 'text-zinc-500'}`}>파이</button>
          </div>
        </div>

        <div className="h-[400px] w-full">
          <ResponsiveContainer width="100%" height="100%">
            {chartType === 'bar' ? (
              <BarChart data={chartData} layout="vertical" margin={{ left: 40, right: 40 }}>
                <CartesianGrid strokeDasharray="3 3" horizontal={false} />
                <XAxis type="number" hide />
                <YAxis dataKey="name" type="category" width={100} tick={{ fontSize: 12 }} />
                <Tooltip formatter={(value: number) => [`${value.toLocaleString()}건`, '데이터 수']} />
                <Bar dataKey="value" radius={[0, 4, 4, 0]}>
                  {chartData.map((entry, index) => <Cell key={`cell-${index}`} fill={entry.color} />)}
                </Bar>
              </BarChart>
            ) : (
              <PieChart>
                <Pie data={chartData} dataKey="value" nameKey="name" cx="50%" cy="50%" outerRadius={120} label>
                  {chartData.map((entry, index) => <Cell key={`cell-${index}`} fill={entry.color} />)}
                </Pie>
                <Tooltip formatter={(value: number) => `${value.toLocaleString()}건`} />
                <Legend />
              </PieChart>
            )}
          </ResponsiveContainer>
        </div>
      </div>
    </div>
  );

  return (
    <ProjectLayout projectNo={project_id as string} token={token} API_BASE={API_BASE}>
      <div className="min-h-screen bg-zinc-50/50 p-8">
        <div className="max-w-6xl mx-auto">
          {/* Header */}
          <div className="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
            <div>
              <div className="flex items-center gap-3 mb-2">
                <div className="w-1.5 h-8 bg-blue-700 rounded-full" />
                <h1 className="text-3xl font-bold text-zinc-900">컬렉션 관리</h1>
              </div>
              <p className="text-zinc-600">데이터를 탐색하고 통계를 확인하세요.</p>
            </div>

            <div className="flex items-center gap-2 bg-white p-1.5 rounded-xl border border-zinc-200 shadow-sm">
              <button onClick={() => setViewMode("grid")} className={`flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium transition ${viewMode === "grid" ? "bg-blue-600 text-white" : "text-zinc-600 hover:bg-zinc-100"}`}>
                <LayoutGrid className="h-4 w-4" /> 카드
              </button>
              <button onClick={() => setViewMode("table")} className={`flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium transition ${viewMode === "table" ? "bg-blue-600 text-white" : "text-zinc-600 hover:bg-zinc-100"}`}>
                <Table className="h-4 w-4" /> 테이블
              </button>
              <button onClick={() => setViewMode("stats")} className={`flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium transition ${viewMode === "stats" ? "bg-blue-600 text-white" : "text-zinc-600 hover:bg-zinc-100"}`}>
                <BarChart3 className="h-4 w-4" /> 통계
              </button>
            </div>
          </div>

          {/* Alert for Model */}
          {hasModel && (
            <div className="mb-6 flex items-start gap-3 p-4 bg-amber-50 border border-amber-200 rounded-xl text-amber-800">
              <XCircle className="w-5 h-5 mt-0.5" />
              <p className="text-sm">학습된 모델이 존재하여 컬렉션 <b>추가 및 삭제가 제한</b>됩니다.</p>
            </div>
          )}

          {/* Search & Actions */}
          <div className="flex flex-col md:flex-row gap-4 mb-6">
            <div className="relative flex-1">
              <Search className="absolute left-4 top-1/2 -translate-y-1/2 h-5 w-5 text-zinc-400" />
              <input
                type="text"
                placeholder="컬렉션 이름으로 검색..."
                value={query}
                onChange={(e) => { setQuery(e.target.value); setPage(1); }}
                className="w-full rounded-xl border border-zinc-200 pl-12 pr-4 py-3 text-sm focus:ring-2 focus:ring-blue-100 outline-none transition-all shadow-sm"
              />
            </div>

            <div className="flex gap-2">
              {!hasModel && (
                <button
                  onClick={() => setIsAddModalOpen(true)}
                  className="flex items-center gap-2 px-5 py-3 bg-blue-600 text-white rounded-xl font-bold hover:bg-blue-700 transition shadow-md"
                >
                  <Plus className="w-5 h-5" /> 추가
                </button>
              )}
              {selectedCollections.length > 0 && (
                <>
                  <button onClick={handleAnalyze} className="flex items-center gap-2 px-5 py-3 bg-indigo-600 text-white rounded-xl font-bold hover:bg-indigo-700 transition shadow-md">
                    <BarChart3 className="w-5 h-5" /> 클러스터 분석
                  </button>
                  {!hasModel && (
                    <button onClick={handleDeleteSelected} className="flex items-center gap-2 px-5 py-3 bg-red-50 text-red-600 border border-red-100 rounded-xl font-bold hover:bg-red-100 transition shadow-sm">
                      <XCircle className="w-5 h-5" /> 삭제 ({selectedCollections.length})
                    </button>
                  )}
                </>
              )}
            </div>
          </div>

          {/* Main Content Area */}
          {loading ? (
            <div className="flex flex-col items-center justify-center py-20 bg-white rounded-3xl border border-zinc-100">
              <Loader2 className="w-10 h-10 animate-spin text-blue-600 mb-4" />
              <p className="text-zinc-500 font-medium">데이터를 불러오는 중입니다...</p>
            </div>
          ) : viewMode === "stats" ? (
            renderStatsView()
          ) : collections.length === 0 ? (
            <div className="bg-white border border-zinc-200 rounded-3xl p-20 text-center">
              <Search className="w-12 h-12 text-zinc-300 mx-auto mb-4" />
              <p className="text-zinc-900 font-semibold text-lg">결과가 없습니다.</p>
              <p className="text-zinc-500">다른 검색어를 입력해 보세요.</p>
            </div>
          ) : viewMode === "grid" ? (
            <div className="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
              {collections.map((c) => (
                <div
                  key={c.id}
                  className={`bg-white rounded-2xl p-6 border transition-all cursor-pointer ${selectedCollections.some(s => s.id === c.id) ? 'border-blue-500 ring-4 ring-blue-50' : 'border-zinc-100 hover:shadow-xl'
                    }`}
                  onClick={() => handleSelectOne(c.id, c.collection_code)}
                >
                  <div className="flex justify-between items-start mb-4">
                    <div className="p-3 bg-blue-50 rounded-xl text-blue-600">
                      <Folder className="w-6 h-6" />
                    </div>
                    <input
                      type="checkbox"
                      checked={selectedCollections.some(s => s.id === c.id)}
                      onChange={(e) => { e.stopPropagation(); handleSelectOne(c.id, c.collection_code); }}
                      className="w-5 h-5 rounded border-zinc-300 text-blue-600"
                    />
                  </div>
                  <h3 className="text-lg font-bold text-zinc-900 mb-1 truncate">{c.collection_name}</h3>
                  <p className="text-xs text-zinc-400 mb-4 font-mono">{c.collection_code}</p>
                  <div className="flex items-center justify-between pt-4 border-t border-zinc-50">
                    <span className="text-sm font-medium text-blue-600">{c.collection_data_num?.toLocaleString()} 건</span>
                    <span className="text-xs text-zinc-400">{new Date().toLocaleDateString()}</span>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div className="bg-white rounded-2xl border border-zinc-200 overflow-hidden shadow-sm">
              <table className="w-full text-left">
                <thead className="bg-zinc-50 border-b border-zinc-200">
                  <tr>
                    <th className="p-4 w-12">
                      <input type="checkbox" onChange={handleSelectAll} checked={collections.length > 0 && selectedCollections.length === collections.length} className="w-4 h-4" />
                    </th>
                    <th className="p-4 text-xs font-bold text-zinc-500 uppercase">컬렉션 명 / 코드</th>
                    <th className="p-4 text-xs font-bold text-zinc-500 uppercase text-right">데이터 수</th>
                    <th className="p-4 text-xs font-bold text-zinc-500 uppercase text-center">작업</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-zinc-100">
                  {collections.map((c) => (
                    <tr key={c.id} className="hover:bg-zinc-50/50 transition">
                      <td className="p-4">
                        <input type="checkbox" checked={selectedCollections.some(s => s.id === c.id)} onChange={() => handleSelectOne(c.id, c.collection_code)} className="w-4 h-4" />
                      </td>
                      <td className="p-4">
                        <p className="font-semibold text-zinc-900">{c.collection_name}</p>
                        <p className="text-xs text-zinc-400 font-mono">{c.collection_code}</p>
                      </td>
                      <td className="p-4 text-right font-medium text-blue-600">{c.collection_data_num?.toLocaleString()}건</td>
                      <td className="p-4 text-center">
                        <button onClick={() => router.push(`/project/${project_id}/collection/${c.id}`)} className="text-xs font-bold text-zinc-400 hover:text-blue-600">상세보기</button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {/* Pagination */}
          {!loading && total > limit && viewMode !== "stats" && (
            <div className="flex justify-center items-center gap-4 mt-10">
              <button disabled={page === 1} onClick={() => setPage(p => p - 1)} className="p-2 border rounded-lg hover:bg-white disabled:opacity-30"><ChevronLeft /></button>
              <span className="text-sm font-bold">{page} / {Math.ceil(total / limit)}</span>
              <button disabled={page * limit >= total} onClick={() => setPage(p => p + 1)} className="p-2 border rounded-lg hover:bg-white disabled:opacity-30"><ChevronRight /></button>
            </div>
          )}
        </div>
      </div>

      {/* Loading Overlay */}
      {isActionLoading && (
        <div className="fixed inset-0 z-[99] flex flex-col items-center justify-center bg-white/80 backdrop-blur-sm">
          <Loader2 className="w-12 h-12 animate-spin text-blue-600 mb-4" />
          <p className="font-bold text-zinc-700">처리 중입니다...</p>
        </div>
      )}

      {/* Add Modal */}
      {isAddModalOpen && (
        <AddCollectionModal
          project_id={project_id as string}
          onClose={() => setIsAddModalOpen(false)}
          onSave={async (name: string) => {
            const success = await addCollection(name);
            if (success) {
              setIsAddModalOpen(false);
              loadCollections();
            }
          }}
        />
      )}
    </ProjectLayout>
  );
}