/* File: frontend/styles/globals.css */
@tailwind base;
@tailwind components;
@tailwind utilities;

/* 선택: 시스템 폰트 기반 살짝 정리 */
html,
body {
  height: 100%;
}

.reset-scope :where(a, button) {
  background: initial;
  border: initial;
  box-shadow: initial;
}

@keyframes slow-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

.animate-slow-spin {
  animation: slow-spin 3s linear infinite;
}

@keyframes reverse-spin {
  from {
    transform: rotate(360deg);
  }

  to {
    transform: rotate(0deg);
  }
}

.animate-reverse-spin {
  animation: reverse-spin 4s linear infinite;
}

.animate-slow-spin {
  animation: spin 3s linear infinite;
}