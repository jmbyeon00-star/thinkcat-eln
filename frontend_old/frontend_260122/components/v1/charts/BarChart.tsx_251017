"use client";
import {
  BarChart,
  Bar,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  ResponsiveContainer,
  LabelList,
  Cell,
} from "recharts";

const barData = [
  { model: "m-BERT", accuracy: 30.2, color: "#94a3b8" },
  { model: "KorPatBERT", accuracy: 50.5, color: "#60a5fa" },
  { model: "IP-Force", accuracy: 69.4, color: "#10b981" },
];

const CustomTooltip = ({ active, payload }) => {
  if (active && payload && payload.length) {
    const data = payload[0].payload;
    return (
      <div className="bg-white px-5 py-4 rounded-xl shadow-2xl border border-zinc-200">
        <p className="text-base font-bold text-zinc-900 mb-2">{data.model}</p>
        <div className="flex items-center gap-2">
          <div 
            className="w-4 h-4 rounded" 
            style={{ backgroundColor: data.color }}
          />
          <span className="text-sm text-zinc-600">정확도:</span>
          <span className="text-lg font-bold text-zinc-900">{data.accuracy}%</span>
        </div>
      </div>
    );
  }
  return null;
};

export default function ModelAccuracyBarChart() {
  const maxAccuracy = Math.max(...barData.map(d => d.accuracy));
  
  return (
    <div className="min-h-screen bg-white p-8">
      <div className="max-w-6xl mx-auto">
        {/* Header */}
        <div className="mb-8">
          {/* <div className="inline-flex items-center gap-2 bg-blue-600 text-white px-4 py-2 rounded-full text-sm font-semibold mb-4">
            <svg className="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/>
              <path fillRule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clipRule="evenodd"/>
            </svg>
            특허 분류 AI 모델 벤치마크
          </div> */}
          <h5 className="text-2xl font-bold text-zinc-900 mb-3">
            한국 특허 CPC 분류 성능 비교
          </h5>
          <p className="text-lg text-zinc-600">
            3,000개 한국 특허 데이터로 학습한 CPC 서브클래스 90종 분류 모델 성능
          </p>
        </div>

        {/* Main Chart Card */}
        <div className="bg-white rounded-3xl shadow-2xl border border-zinc-100 overflow-hidden">
          {/* Dataset Info Banner */}
          <div className="bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 px-8 py-6">
            <div className="flex items-center justify-between text-white">
              <div>
                <div className="text-sm font-medium text-blue-100 mb-1">학습 데이터셋</div>
                <div className="text-2xl font-bold">3,000개 한국 특허</div>
              </div>
              <div className="text-right">
                <div className="text-sm font-medium text-blue-100 mb-1">분류 클래스</div>
                <div className="text-2xl font-bold">90종 CPC 서브클래스</div>
              </div>
            </div>
          </div>

          {/* Performance Stats */}
          <div className="grid grid-cols-3 gap-6 px-8 py-8 bg-gradient-to-b from-zinc-50 to-white border-b border-zinc-100">
            {barData.map((item, idx) => (
              <div 
                key={item.model}
                className="relative bg-white rounded-2xl p-6 shadow-lg border-2 transition-all duration-300 hover:scale-105 hover:shadow-xl"
                style={{ borderColor: item.color }}
              >
                {item.accuracy === maxAccuracy && (
                  <div className="absolute -top-3 -right-3 bg-yellow-400 text-yellow-900 text-xs font-bold px-3 py-1 rounded-full shadow-lg">
                    🏆 Best
                  </div>
                )}
                <div className="flex items-center gap-3 mb-3">
                  <div 
                    className="w-12 h-12 rounded-xl flex items-center justify-center text-white font-bold text-lg shadow-md"
                    style={{ backgroundColor: item.color }}
                  >
                    {idx + 1}
                  </div>
                  <div>
                    <div className="text-sm text-zinc-500 font-medium">모델</div>
                    <div className="text-lg font-bold text-zinc-900">{item.model}</div>
                  </div>
                </div>
                <div className="mt-4 pt-4 border-t border-zinc-100">
                  <div className="text-sm text-zinc-500 mb-1">분류 정확도</div>
                  <div className="text-3xl font-bold" style={{ color: item.color }}>
                    {item.accuracy}%
                  </div>
                </div>
              </div>
            ))}
          </div>

          {/* Chart */}
          <div className="p-8">
            <h3 className="text-xl font-bold text-zinc-900 mb-6 flex items-center gap-2">
              <div className="w-1 h-6 bg-gradient-to-b from-blue-600 to-purple-600 rounded-full" />
              모델별 성능 비교
            </h3>
            
            <div className="w-full h-96">
              <ResponsiveContainer width="100%" height="100%">
                <BarChart 
                  data={barData} 
                  margin={{ top: 30, right: 30, left: 20, bottom: 30 }}
                >
                  <defs>
                    {barData.map((entry, index) => (
                      <linearGradient key={index} id={`gradient-${index}`} x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stopColor={entry.color} stopOpacity={1}/>
                        <stop offset="100%" stopColor={entry.color} stopOpacity={0.7}/>
                      </linearGradient>
                    ))}
                  </defs>
                  
                  <CartesianGrid strokeDasharray="3 3" stroke="#e4e4e7" vertical={false} />
                  
                  <XAxis 
                    dataKey="model"
                    tick={{ fill: '#52525b', fontSize: 14, fontWeight: 600 }}
                    axisLine={{ stroke: '#d4d4d8' }}
                  />
                  
                  <YAxis 
                    domain={[0, 100]}
                    tick={{ fill: '#52525b', fontSize: 12 }}
                    axisLine={{ stroke: '#d4d4d8' }}
                    label={{ 
                      value: "정확도 (%)", 
                      angle: -90, 
                      position: "insideLeft",
                      style: { fill: '#3f3f46', fontWeight: 600 }
                    }}
                  />
                  
                  <Tooltip content={<CustomTooltip />} cursor={{ fill: 'rgba(0,0,0,0.05)' }} />
                  
                  <Bar 
                    dataKey="accuracy" 
                    radius={[12, 12, 0, 0]}
                    maxBarSize={120}
                  >
                    {barData.map((entry, index) => (
                      <Cell 
                        key={`cell-${index}`} 
                        fill={`url(#gradient-${index})`}
                        stroke={entry.color}
                        strokeWidth={2}
                      />
                    ))}
                    <LabelList 
                      dataKey="accuracy" 
                      position="top"
                      offset={12}
                      formatter={(v) => `${v}%`}
                      style={{ 
                        fontSize: '16px', 
                        fontWeight: 700,
                        fill: '#18181b'
                      }}
                    />
                  </Bar>
                </BarChart>
              </ResponsiveContainer>
            </div>
          </div>

          {/* Insights Section */}
          <div className="px-8 py-6 bg-gradient-to-r from-green-50 to-emerald-50 border-t border-green-100">
            <div className="flex items-start gap-4">
              <div className="bg-green-500 text-white rounded-full p-2 mt-1">
                <svg className="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                  <path fillRule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clipRule="evenodd"/>
                </svg>
              </div>
              <div>
                <h4 className="text-lg font-bold text-green-900 mb-2">주요 성과</h4>
                <p className="text-green-800 leading-relaxed">
                  <strong>IP-Force 모델</strong>이 <strong className="text-green-600">69.4%</strong>의 최고 정확도를 달성하여 
                  KorPatBERT 대비 <strong>18.9%p</strong>, m-BERT 대비 <strong>39.2%p</strong> 향상된 성능을 보였습니다.
                </p>
              </div>
            </div>
          </div>
        </div>

        {/* Additional Info */}
        <div className="mt-6 flex items-center justify-between text-sm text-zinc-500">
          <div className="flex items-center gap-2">
            <div className="w-2 h-2 bg-blue-500 rounded-full animate-pulse" />
            실시간 업데이트됨
          </div>
          <div>
            CPC: Cooperative Patent Classification
          </div>
        </div>
      </div>
    </div>
  );
}