name: CI/CD - IPFORCE

on:
  push:
    branches:
      - main

jobs:
  # 1단계: 코드 검사 (CI)
  test:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node for frontend
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Install and Build(no Lint) (frontend)
        working-directory: ./frontend
        run: |
          npm ci
          # npm run lint
          npm run build

      - name: Setup Python for backend
        uses: actions/setup-python@v5
        with:
          python-version: "3.10"

      - name: Install dependencies (backend)
        working-directory: ./backend
        run: |
          pip install -r requirements.txt
          pytest || echo "테스트 실패 (나중에 개선 가능)"

  # 2단계: 배포 (CD)
  deploy:
    runs-on: ubuntu-latest
    needs: test   # ← test job이 성공해야 deploy 실행됨
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Deploy via SSH
        uses: appleboy/ssh-action@v1.0.0
        with:
          host: ${{ secrets.SSH_HOST }}
          username: ${{ secrets.SSH_USER }}
          key: ${{ secrets.SSH_KEY }}
          script: |
            cd ${{ secrets.DEPLOY_PATH }}
            
            echo "현재 접속 위치: $(pwd)"
            echo "코드 동기화 중..."
            
            fi

            echo "Docker 빌드 및 실행..."
            echo "배포 완료!"
