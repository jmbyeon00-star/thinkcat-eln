"use client";

import { useEffect, useState } from "react";
import { CircleDashed, CircleCheckBig, AlertCircle, Sparkles, Plus, ChevronRight, Search } from "lucide-react";
import { useSession } from "next-auth/react";
import type { Session } from "next-auth";
import { useRouter } from "next/router";
import ProjectLayout from "@/components/layouts/ProjectLayout";

// ModelProgressSSE 컴포넌트가 존재한다고 가정
// 이 페이지에서는 목록 표시만 하므로, SSE는 상세 페이지에서 사용하는 것이 더 적절합니다.
// 여기서는 RUNNING 상태 표시를 위해 progress만 보여줍니다.

// --- 재활용 타입 및 설정 ---

type Model = {
    id: number;
    model_name: string;
    model_desc?: string;
    task_type: string;
    progress: number;
    progress_status: "RUNNING" | "COMPLETED" | "FAILED";
    data_type: string;
    created_datetime?: string;
};

const taskMapper: Record<string, string> = {
    classification: "분류",
    recommedation: "추천",
    etc: "기타",
};

const statusConfig = {
    RUNNING: {
        icon: CircleDashed,
        label: "학습 중",
        color: "text-blue-600",
        bg: "from-blue-50 to-cyan-50",
        ring: "ring-blue-100",
        badge: "bg-blue-100 text-blue-700 border-blue-200",
    },
    COMPLETED: {
        icon: CircleCheckBig,
        label: "학습 완료",
        color: "text-emerald-600",
        bg: "from-emerald-50 to-teal-50",
        ring: "ring-emerald-100",
        badge: "bg-emerald-100 text-emerald-700 border-emerald-200",
    },
    FAILED: {
        icon: AlertCircle,
        label: "학습 실패",
        color: "text-red-600",
        bg: "from-red-50 to-pink-50",
        ring: "ring-red-100",
        badge: "bg-red-100 text-red-700 border-red-200",
    },
};

type Project = {
    project_name: string;
    project_descriptoin: string;
    collection_num: number;
    task_type: string;
    source_type: string;
};

// --- 메인 컴포넌트 ---

export default function ProjectModelListPage() {
    const router = useRouter();
    const { project_id } = router.query; // URL에서 project_id를 가져옵니다.
    const API_BASE = process.env.NEXT_PUBLIC_API_BASE_URL;

    const [projectInfo, setProjectInfo] = useState<Project | null>(null);
    const [models, setModels] = useState<Model[]>([]);
    const [isLoading, setIsLoading] = useState(true);

    const [query, setQuery] = useState("");
    const [page, setPage] = useState(1);
    const [limit] = useState(6);
    const [total, setTotal] = useState(0);

    // 이 페이지는 전체 목록을 보여주므로 간단한 필터링만 남김
    const [filterTaskType, setFilterTaskType] = useState<string>('all');

    const { data: session } = useSession() as {
        data: (Session & { access_token?: string }) | null;
        status: "loading" | "authenticated" | "unauthenticated";
    };
    const token = session?.access_token;

    useEffect(() => {
        if (!token || !project_id) return;

        async function loadModels() {
            try {
                setIsLoading(true);

                // API 호출을 project_id에 맞춰 변경
                const res = await fetch(
                    `${API_BASE}/api/project/${project_id}/models?page=${page}&limit=${limit}&q=${encodeURIComponent(query)}`, {
                    headers: {
                        Authorization: `Bearer ${token}`
                    },
                    credentials: "include"
                });

                if (!res.ok) throw new Error("모델 목록 로드 실패");

                const data = await res.json();
                // 일반적으로 project에 종속된 모델 목록을 받아올 것이므로, 
                // data 자체가 Model[] 배열이라고 가정합니다.
                setModels(data.model_list || []);
                setProjectInfo(data.project_info || []);

            } catch (e) {
                console.error("AI 모델 목록 로드 실패:", e);
            } finally {
                setIsLoading(false);
            }
        }

        loadModels();

    }, [token, project_id, query, page, limit]);

    const filteredModels = models.filter(m =>
        filterTaskType === 'all' || m.task_type === filterTaskType
    );

    // 상세 페이지로 이동
    const navigateToDetail = (modelId: number) => {
        router.push(`/project/train/${project_id}/${modelId}`);
    };

    // 새 모델 생성 페이지로 이동
    const navigateToNew = () => {
        router.push(`/project/train/${project_id}/new`);
    };

    return (
        <ProjectLayout step={5} sourceType={projectInfo?.source_type} projectNo={Number(project_id)} projectName={projectInfo?.project_name} projectDesc={projectInfo?.project_description}>
            <div className="min-h-screen bg-white p-8">
                <div className="max-w-5xl mx-auto">
                    {/* Header and Action Button */}
                    <div className="flex items-start justify-between mb-8">
                        <div>
                            <div className="flex items-center gap-2 mb-2">
                                <h1 className="text-2xl font-bold text-zinc-900 truncate">
                                    [{projectInfo?.project_name}] 학습 모델 목록
                                </h1>

                            </div>
                            <p className="text-zinc-600">
                                이 프로젝트로 학습된 모든 AI 모델을 관리합니다.
                            </p>
                        </div>



                        {/* New Model Button */}
                        <button
                            onClick={navigateToNew}
                            className="flex items-center gap-2 rounded-xl bg-blue-600 px-6 py-3 text-sm font-medium text-white hover:bg-blue-700 transition-all shadow-lg shadow-blue-200"
                        >
                            <Plus className="h-4 w-4" />
                            <span>새로운 모델 만들기</span>
                        </button>
                    </div>

                    <div className="mb-6">
                        <div className="relative">
                            <Search className="absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-zinc-400" />
                            <input
                                type="text"
                                placeholder="모델 이름으로 검색..."
                                value={query}
                                onChange={(e) => {
                                    setQuery(e.target.value);
                                    setPage(1);
                                }}
                                className="w-full rounded-xl border border-zinc-200 pl-12 pr-4 py-3 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all shadow-sm"
                            />
                        </div>
                    </div>
                    {/* Filter Bar (Simplified) */}
                    <div className="mb-6 flex gap-3">
                        <button
                            onClick={() => setFilterTaskType('all')}
                            className={`px-4 py-2 rounded-full text-sm font-medium transition-colors ${filterTaskType === 'all'
                                ? 'bg-blue-600 text-white shadow-md'
                                : 'bg-zinc-50 text-zinc-600 hover:bg-zinc-100 border border-zinc-200'
                                }`}
                        >
                            전체 ({models.length})
                        </button>
                        {Object.keys(taskMapper).map(key => (
                            <button
                                key={key}
                                onClick={() => setFilterTaskType(key)}
                                className={`px-4 py-2 rounded-full text-sm font-medium transition-colors ${filterTaskType === key
                                    ? 'bg-blue-100 text-blue-700 border border-blue-300'
                                    : 'bg-zinc-50 text-zinc-600 hover:bg-zinc-100 border border-zinc-200'
                                    }`}
                            >
                                {taskMapper[key]} ({models.filter(m => m.task_type === key).length})
                            </button>
                        ))}
                    </div>


                    {/* Loading State */}
                    {isLoading ? (
                        <div className="grid gap-4 md:grid-cols-2">
                            {[...Array(4)].map((_, i) => (
                                <div key={i} className="animate-pulse bg-white rounded-2xl shadow-sm border border-zinc-100 p-6 space-y-4">
                                    <div className="h-5 bg-zinc-100 rounded w-3/4"></div>
                                    <div className="h-4 bg-zinc-100 rounded w-full"></div>
                                    <div className="h-4 bg-zinc-100 rounded w-1/2"></div>
                                </div>
                            ))}
                        </div>
                    ) : filteredModels.length === 0 ? (
                        /* Empty State */
                        <div className="bg-zinc-50 border border-zinc-200 rounded-2xl p-12 text-center">
                            <div className="w-16 h-16 bg-zinc-100 rounded-full flex items-center justify-center mx-auto mb-4">
                                <Sparkles className="w-8 h-8 text-zinc-400" />
                            </div>
                            <p className="text-lg font-medium text-zinc-900 mb-2">
                                {filterTaskType === 'all' ? "이 프로젝트의 학습 모델이 없습니다." : `선택한 유형의 모델이 없습니다.`}
                            </p>
                            {filterTaskType === 'all' && (
                                <button
                                    onClick={navigateToNew}
                                    className="mt-4 inline-flex items-center gap-2 text-sm font-medium text-blue-600 hover:text-blue-700 hover:underline"
                                >
                                    <Plus className="h-4 w-4" /> 지금 새로운 모델 만들러 가기
                                </button>
                            )}
                        </div>
                    ) : (
                        /* Model List (Card View Only) */
                        <div className="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mb-8">
                            {filteredModels.map((m) => {
                                const config = statusConfig[m.progress_status];
                                const Icon = config.icon;

                                return (
                                    <div
                                        key={m.id}
                                        onClick={() => navigateToDetail(m.id)}
                                        className="block cursor-pointer group"
                                    >
                                        <div className="bg-white rounded-2xl shadow-sm border border-zinc-100 p-6 hover:shadow-xl hover:border-blue-200 transition-all duration-300">
                                            <div className="flex items-start gap-4">
                                                {/* Icon */}
                                                <div className={`rounded-xl bg-gradient-to-br ${config.bg} p-3 ring-1 ${config.ring} group-hover:ring-blue-300 transition-all`}>
                                                    <Icon className={`h-6 w-6 ${config.color}`} />
                                                </div>

                                                {/* Content */}
                                                <div className="flex-1 min-w-0">
                                                    <div className="flex items-start justify-between gap-2 mb-2">
                                                        <h2 className="text-lg font-semibold text-zinc-900 group-hover:text-blue-600 transition-colors truncate">
                                                            {m.model_name}
                                                        </h2>
                                                        <span className={`px-2 py-1 rounded-md text-xs font-medium border whitespace-nowrap ${config.badge}`}>
                                                            {config.label}
                                                        </span>
                                                    </div>

                                                    <p className="text-sm text-zinc-600 mb-3 line-clamp-2">
                                                        {m.model_desc || `${taskMapper[m.task_type] ?? m.task_type} 모델`}
                                                    </p>
                                                </div>
                                            </div>

                                            {/* Footer / Progress */}
                                            <div className="mt-4 border-t pt-4 border-zinc-100">
                                                <div className="flex items-center justify-between text-xs text-zinc-500 mb-1">
                                                    <span>{taskMapper[m.task_type] ?? m.task_type}</span>
                                                    <span className="font-semibold">{m.progress}%</span>
                                                </div>
                                                <div className="relative w-full bg-zinc-200 rounded-full h-2">
                                                    <div
                                                        className={`h-2 rounded-full transition-all duration-500 ${m.progress === 100 ? "bg-emerald-500" : m.progress_status === "FAILED" ? "bg-red-500" : "bg-blue-500"
                                                            }`}
                                                        style={{ width: `${m.progress}%` }}
                                                    />
                                                </div>
                                                <div className="text-right mt-2">
                                                    <span className="inline-flex items-center gap-1 text-xs font-medium text-blue-600 group-hover:underline">
                                                        상세 보기 <ChevronRight className="h-3 w-3" />
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                );
                            })}
                        </div>
                    )}
                </div>
            </div>
        </ProjectLayout >
    );
}