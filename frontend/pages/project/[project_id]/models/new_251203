// models/new.tsx

import { useRouter } from "next/router";
import React, { useEffect, useState, useCallback, useMemo } from "react";
import ProjectLayout from "@/components/layouts/ProjectLayout";
import { Settings, ArrowLeft, ArrowRight, Loader2, Info, Zap } from "lucide-react";
import { useSession } from "next-auth/react";
import { Session } from "next-auth";

// 컴포넌트 및 유틸리티 import (가정)
import DataSourceSelector from "@/components/project/DataSourceSelector";
import { useUserTaskStore } from '@/lib/store/useUserTaskStore';
import { getDeduplicationConfig } from '@/utils/common';

import SearchComponent from "@/components/project/SearchComponent_251203";
import UploadComponent from "@/components/project/UploadComponent_251203";
import StepIndicator from "@/components/project/StepIndicator";

// ------------------------------
// 1. 타입 정의 (백엔드 및 컴포넌트에서 사용하는 타입)
// ------------------------------
// 기존 데이터 그룹 요약 정보
interface DataGroupInfo {
    group_code: string;
    group_name: string;
    count: number;
    last_updated: string;
}
interface ExistingDataSummary {
    total_count: number;
    group_count: number;
    groups: DataGroupInfo[];
    last_updated: string;
}
// 새 데이터 소스 정보 타입 (common.ts와 동일해야 함)
type NewDataSourceInfo = {
    sourceType: 'upload' | 'search';
    fileIds?: number[];
    searchKey?: string;
    standardDedupKey?: string; // 표준 키 (예: '출원번호')
    fileHeaders?: string[];   // 업로드된 파일의 헤더 목록
    count?: number;
};

// ------------------------------
// 2. ProjectTrainPage 본문
// ------------------------------
export default function ProjectTrainPage() {
    const router = useRouter();
    const { project_id, collection_num, task_type, source_type } = router.query;

    const { setState } = useUserTaskStore();
    const API_BASE = process.env.NEXT_PUBLIC_API_BASE_URL;
    const { data: session } = useSession() as {
        data: (Session & { access_token?: string }) | null;
        status: "loading" | "authenticated" | "unauthenticated";
    };

    const token = session?.access_token;
    const projectIdString = Array.isArray(project_id) ? project_id[0] : (project_id as string || '');


    // -------------------
    // 2-1. 상태 관리
    // -------------------
    const steps = [
        { number: 1, title: '데이터 준비', description: '데이터 선택/추가' },
        { number: 2, title: '학습 설정', description: '파라미터 설정' },
    ];

    const [currentStep, setCurrentStep] = useState<number>(1);
    const [hasExistingData, setHasExistingData] = useState(false);
    const [existingDataSummary, setExistingDataSummary] = useState<ExistingDataSummary | null>(null);

    // 데이터 소스 관리
    const [selectedExistingGroups, setSelectedExistingGroups] = useState<DataGroupInfo[]>([]);
    console.log("group:", selectedExistingGroups)
    const [newDataSourceInfo, setNewDataSourceInfo] = useState<NewDataSourceInfo | null>(null);
    const [activeSourceType, setActiveSourceType] = useState<'selector' | 'upload' | 'search'>('selector');


    // 중복 제거 관련 상태
    const [customDedupKeys, setCustomDedupKeys] = useState<string[]>([]);
    const [deduplicationEnabled, setDeduplicationEnabled] = useState(false);

    // 프로젝트/학습 설정 관련 상태
    const [project, setProject] = useState<Project | null>(null);
    const [collections, setCollections] = useState<Collections | null>(null);
    const [loading, setLoading] = useState(true);
    const [projectInfo, setProjectInfo] = useState<ProjectInfo | null>(null);
    const [trainLoading, setTrainLoading] = useState(false);

    // 학습 파라미터 상태
    const [modelName, setModelName] = useState('');
    const [modelDesc, setModelDesc] = useState('');
    const [epoch, setEpoch] = useState(10);
    const [batchSize, setBatchSize] = useState(128);
    const [learningRate, setLearningRate] = useState(1e-5);
    const [maxLength, setMaxLength] = useState(256);
    const [shuffle, setShuffle] = useState(true);
    const [status, setStatus] = useState(false);

    // -------------------
    // 2-2. 핸들러 및 계산 로직
    // -------------------

    // A. 기존 그룹 선택 상태 변경 핸들러
    const handleExistingGroupsChange = useCallback((groups: DataGroupInfo[]) => {
        setSelectedExistingGroups(groups);
    }, []);

    // B. 새 데이터 준비 완료 핸들러
    const handleNewDataReady = useCallback((dataInfo: NewDataSourceInfo) => {
        // 상태 초기화 및 설정
        setNewDataSourceInfo(dataInfo);
        setCustomDedupKeys([]); // 커스텀 키 초기화
        setDeduplicationEnabled(false); // 중복 제거 설정 초기화
        setActiveSourceType('selector'); // 셀렉터 뷰로 복귀

        // 표준 키 (출원번호) 확인 및 설정
        const standardKey = '출원번호';
        let hasStandardKey = false;

        if (dataInfo.sourceType === 'upload' && dataInfo.fileHeaders?.includes(standardKey)) {
            dataInfo.standardDedupKey = standardKey;
            hasStandardKey = true;
        } else if (dataInfo.sourceType === 'search') {
            // 검색 결과는 표준 키가 있다고 가정
            dataInfo.standardDedupKey = standardKey;
            hasStandardKey = true;
        }

        // 표준 키가 있으면 기본값은 활성화로 설정
        if (hasStandardKey) {
            setDeduplicationEnabled(true);
        }
    }, []);

    // C. 중복 제거 조건 계산 (useMemo 사용)
    const { isDeduplicationRelevant, isCustomSelectionRequired } = useMemo(() => {
        const isSelected = selectedExistingGroups.length > 0 || newDataSourceInfo !== null;

        // 기존 데이터 + 새 데이터 조합이어야 의미가 있습니다.
        const relevant = (selectedExistingGroups.length > 0 && newDataSourceInfo !== null);

        // 커스텀 선택이 필요한 경우: 기존 데이터와 새 데이터가 모두 선택되었고, 파일 업로드이며, 표준 키가 없는 경우
        const customRequired = relevant &&
            !newDataSourceInfo?.standardDedupKey &&
            newDataSourceInfo?.sourceType === 'upload';

        return {
            isDeduplicationRelevant: relevant,
            isCustomSelectionRequired: customRequired,
        };
    }, [selectedExistingGroups, newDataSourceInfo]);


    // D. 최종 '다음' 버튼 활성화 조건
    const isNextStepEnabled = useMemo(() => {
        const isDataReady = selectedExistingGroups.length > 0 || newDataSourceInfo !== null;

        if (!isDataReady) return false;

        // 커스텀 키 선택이 필수인 경우
        if (isCustomSelectionRequired) {
            // 중복 제거가 활성화되었지만 키가 하나도 없으면 비활성
            if (deduplicationEnabled && customDedupKeys.length === 0) {
                return false;
            }
            // 중복 제거가 비활성화되거나, 키를 올바르게 선택했으면 활성
            return true;
        }

        return true;
    }, [selectedExistingGroups, newDataSourceInfo, isCustomSelectionRequired, customDedupKeys, deduplicationEnabled]);


    // E. 다음 단계로 이동하는 버튼 핸들러 (데이터 전송 및 통합)
    const handleDataPreparationComplete = async () => {
        if (!isNextStepEnabled || trainLoading) return;

        // 1. 유틸리티 함수를 사용하여 중복 제거 설정 획득
        const { enabled: deduplicate_enabled, keys: deduplication_keys } = getDeduplicationConfig(
            newDataSourceInfo,
            customDedupKeys,
            deduplicationEnabled
        );

        // 2. 통합 데이터 구조 생성
        const integratedDataPayload = {
            project_id: projectIdString,
            existing_group_codes: selectedExistingGroups.map(g => g.group_code),
            new_data_source: newDataSourceInfo,
            deduplicate_enabled,
            deduplication_keys,
        };

        console.log("통합 데이터 전송 준비:", integratedDataPayload);

        // 3. 통합 API 호출 (로직 생략)
        try {
            setTrainLoading(true);
            // const res = await fetch(`${API_BASE}/api/project/data/integrate/${projectIdString}`, { ... });

            // 시뮬레이션: 3초 후 성공
            await new Promise(resolve => setTimeout(resolve, 3000));

            setCurrentStep(2);

        } catch (error) {
            console.error("데이터 통합 요청 실패:", error);
            alert("데이터 통합 및 준비 실패");
        } finally {
            setTrainLoading(false);
        }
    };

    // -------------------
    // 2-3. 렌더링 (JSX)
    // -------------------
    // 프로젝트 정보 및 컬렉션 불러오기
    useEffect(() => {
        if (!project_id || !router.isReady) return;

        async function loadProjectData() {
            try {
                // URL 쿼리에서 collection_num, task_type, source_type이 있으면 사용
                if (collection_num) {
                    setProjectInfo({
                        collection_num: Number(collection_num),
                        task_type: String(task_type),
                        source_type: String(source_type),
                    });
                }

                // 프로젝트 정보 가져오기
                const resProject = await fetch(`${API_BASE}/api/project/${project_id}`, {
                    headers: { Authorization: `Bearer ${token}` },
                });
                const dataProject = await resProject.json();

                console.log("dataProject:", dataProject)
                setProject(dataProject);

                // 프로젝트 통계 정보 가져오기 (collection_num이 없는 경우)
                if (!collection_num) {
                    const resStats = await fetch(`${API_BASE}/api/project/${project_id}/stats`, {
                        headers: { Authorization: `Bearer ${token}` },
                    });
                    const dataStats = await resStats.json();
                    const collectionNumber = dataStats?.project_info?.collection_num ?? 0;
                    const taskType = dataStats?.project_info?.task_type ?? '';
                    const sourceType = dataStats?.project_info?.source_type ?? '';
                    setProjectInfo({
                        collection_num: collectionNumber,
                        source_type: sourceType,
                        task_type: taskType
                    });
                    console.log("dataStats:",)
                }

                // 컬렉션 정보 가져오기 (search 타입인 경우)
                if (dataProject.source_type === 'search') {
                    const resCollections = await fetch(`${API_BASE}/api/collection/project/${project_id}`, {
                        headers: { Authorization: `Bearer ${token}` },
                        credentials: "include"
                    });
                    const dataCollections = await resCollections.json();
                    setCollections(dataCollections);
                }
            } catch (error) {
                console.error("프로젝트 정보 불러오기 실패:", error);
                alert("프로젝트 정보를 불러오지 못했습니다.");
            } finally {
                setLoading(false);
            }
        }

        loadProjectData();
    }, [project_id, router.isReady, collection_num]);

    const fetchExistingDataGroups = async () => {
        if (!project_id || !token) return;

        try {
            // API 호출: 페이지네이션 없이 전체 요약 데이터를 가져올 경우 (옵션: page=1, limit=1000 등)
            // GroupDataViewer에서 페이지네이션을 처리하므로, 여기서는 초기 요약 정보만 가져온다고 가정합니다.
            const response = await fetch(`${API_BASE}/api/project/${project_id}/data/groups?page=1&limit=10`, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    Authorization: `Bearer ${token}`,
                },
                credentials: "include",
            });

            if (!response.ok) {
                setHasExistingData(false);
                return;
            }

            const apiResponse = await response.json(); // API 응답 전체
            const dataGroups = apiResponse.project_data_groups; // 그룹 데이터 부분

            const groupCodes = Object.keys(dataGroups);
            if (groupCodes.length === 0) {
                setHasExistingData(false);
                return;
            }

            const groups: DataGroupInfo[] = groupCodes.map((groupCode) => {
                // 백엔드 응답 구조: { "count": N, "data": [...] }
                const groupData = dataGroups[groupCode];
                const count = groupData.count;
                const dataList = groupData.data || [];
                const lastItem = dataList[dataList.length - 1]; // 데이터 리스트의 마지막 항목 사용

                return {
                    group_code: groupCode,
                    // group_name은 ProjectData 객체의 collection_name 필드를 사용 (임시)
                    group_name: dataList[0]?.collection_name || groupCode,
                    count: count,
                    last_updated: lastItem?.created_at || new Date().toISOString(),
                };
            });

            // 기존 데이터 요약 정보 (API 응답에서 total_count와 group_count 사용)
            const totalCount = apiResponse.total_count; // 백엔드에서 받은 total_count 사용
            const groupCount = apiResponse.project_data_groups.length; // 이 페이지의 그룹 개수

            // 전체 그룹의 최종 업데이트 날짜 계산 (기존 로직 유지)
            const lastUpdated = groups.reduce((latest, group) => {
                const groupDate = new Date(group.last_updated);
                const latestDate = new Date(latest);
                return groupDate > latestDate ? group.last_updated : latest;
            }, groups[0].last_updated);

            setExistingDataSummary({
                total_count: totalCount,
                group_count: apiResponse.total_count, // 전체 그룹 개수를 사용
                groups: groups,
                last_updated: lastUpdated,
            });

            setHasExistingData(true);
        } catch (error) {
            console.error("기존 데이터 조회 실패:", error);
            setHasExistingData(false);
        }
    };

    useEffect(() => {
        if (project && token) {
            fetchExistingDataGroups();
        }
    }, [project, token]);


    // 학습 시작 함수
    const handleSubmit = () => {
        if (!project_id || !modelName.trim()) {
            alert("모델명을 입력해주세요.");
            return;
        }

        setState({ isBusy: true, status: 'RUNNING', progress: 0 })
        setTrainLoading(true);

        fetch(`${API_BASE}/api/ai/train/classification/project/${project_id}`, {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                Authorization: `Bearer ${token}`
            },
            credentials: "include",
            body: JSON.stringify({
                epoch,
                model_name: modelName,
                model_desc: modelDesc,
                batch_size: batchSize,
                learning_rate: learningRate,
                max_length: maxLength,
                shuffle: shuffle,
                data_scope: "project",
                run_type: "train",
                collection_num: projectInfo?.collection_num,
                task_type: projectInfo?.task_type,
                source_type: projectInfo?.source_type,
            }),
        })
            .then((res) => res.json())
            .then(() => {
                setTrainLoading(false);
                setStatus(true);
                alert("학습이 시작되었습니다!");
                router.push(`/ai`);
            })
            .catch((err) => {
                console.error("학습 요청 실패:", err);
                setState({ isBusy: false, status: 'AVAILABLE' })
                setTrainLoading(false);
                alert("학습 시작 실패");
            });
    };

    if (loading) {
        return (
            <div className="flex min-h-screen items-center justify-center bg-white">
                <div className="flex items-center gap-3">
                    <Loader2 className="w-6 h-6 animate-spin text-blue-600" />
                    <span className="text-zinc-600">불러오는 중...</span>
                </div>
            </div>
        );
    }

    if (!project) {
        return (
            <div className="flex min-h-screen items-center justify-center bg-white">
                <div className="text-zinc-600">프로젝트를 찾을 수 없습니다.</div>
            </div>
        );
    }

    return (
        <ProjectLayout
            projectNo={project.id}
            projectName={project.project_name}
            projectDesc={project.project_description}
            sourceType={project.source_type}
        >
            <div className="min-h-screen bg-white p-8">
                <div className="max-w-6xl mx-auto space-y-6">

                    {/* Header */}
                    <div className="mb-8">
                        <div className="flex items-center gap-3 mb-3">
                            <div className="w-1 h-8 bg-gradient-to-b from-blue-600 to-indigo-600 rounded-full" />
                            <h1 className="text-3xl font-bold text-zinc-900">학습 설정</h1>
                        </div>
                        <p className="text-zinc-600 ml-4">
                            데이터를 수집하고 모델 학습 파라미터를 설정하세요
                        </p>
                    </div>

                    {/* Step Indicator */}
                    <StepIndicator currentStep={currentStep} steps={steps} />


                    {/* Project Info Card */}
                    {/* <div className="bg-white rounded-2xl shadow-xl border border-zinc-100 overflow-hidden">
                        <div className="bg-gradient-to-r from-blue-600 to-indigo-600 px-8 py-6">
                            <h2 className="text-2xl font-bold text-white">{project.project_name}</h2>
                            <p className="text-blue-100 text-sm mt-1">{project.project_description || "-"}</p>
                        </div>
                        <div className="px-8 py-4 bg-zinc-50 border-b border-zinc-100 flex items-center gap-4 text-sm">
                            <span className="px-3 py-1 bg-blue-100 text-blue-700 rounded-full font-medium">
                                {taskMapper[project.task_type]}
                            </span>
                            <span className="px-3 py-1 bg-emerald-100 text-emerald-700 rounded-full font-medium">
                                {project.source_type === 'search' ? '데이터베이스 검색' : '파일 업로드'}
                            </span>
                            <span className="text-zinc-500">
                                {project.created_datetime ? new Date(project.created_datetime).toLocaleString() : "-"}
                            </span>
                        </div>
                    </div> */}

                    {/* Info Box */}
                    <div className="bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-100 rounded-xl p-4">
                        <div className="flex items-start gap-3">
                            <Info className="w-5 h-5 text-blue-600 mt-0.5 flex-shrink-0" />
                            <div>
                                <p className="text-sm font-semibold text-blue-900 mb-1">워크플로우 안내</p>
                                <p className="text-xs text-blue-800 leading-relaxed">
                                    {project.source_type === 'search'
                                        ? '1단계: 검색을 통해 데이터를 수집하고 → 2단계: 학습 파라미터를 설정한 후 학습을 시작하세요.'
                                        : '1단계: 파일을 업로드하여 데이터를 준비하고 → 2단계: 학습 파라미터를 설정한 후 학습을 시작하세요.'}
                                </p>
                            </div>
                        </div>
                    </div>

                    {/* Step 1: 데이터 선택 */}
                    {currentStep === 1 && (
                        <div className="bg-white rounded-2xl shadow-xl border border-zinc-100 overflow-hidden">
                            <div className="bg-gradient-to-r from-blue-600 to-indigo-600 px-8 py-6">
                                <h2 className="text-xl font-semibold text-white">데이터 소스 선택 및 준비</h2>
                            </div>
                            <div className="p-8">
                                <DataSourceSelector
                                    hasExistingData={hasExistingData}
                                    existingDataSummary={existingDataSummary}
                                    projectId={projectIdString}
                                    token={token}
                                    onSelectExisting={handleExistingGroupsChange}
                                    // 💡 수정된 핸들러: 새 데이터 추가 버튼 클릭 시 소스 타입에 따라 뷰 전환
                                    onSelectNew={() => setActiveSourceType(project?.source_type === 'upload' ? 'upload' : 'search')}
                                />

                                {/* 1. 새 데이터 추가 컴포넌트 렌더링 (source_type에 따라) */}
                                {(activeSourceType === 'upload' || activeSourceType === 'search') && (
                                    <div className='space-y-4 pt-6'>
                                        <button onClick={() => setActiveSourceType('selector')} className='text-sm text-blue-500 hover:text-blue-700 font-medium flex items-center gap-1 mb-4'>
                                            <ArrowLeft size={16} /> 데이터 소스 선택으로 돌아가기
                                        </button>

                                        {/* 💡 PROJECT_INFO_TB의 source_type에 고정된 컴포넌트만 렌더링 */}
                                        {project?.source_type === 'upload' ? (
                                            <UploadComponent onNewDataReady={handleNewDataReady} onCancel={() => setActiveSourceType('selector')} />
                                        ) : project?.source_type === 'search' ? (
                                            <SearchComponent onNewDataReady={handleNewDataReady} onCancel={() => setActiveSourceType('selector')} />
                                        ) : (
                                            <div className="text-red-500">프로젝트 소스 타입이 유효하지 않습니다.</div>
                                        )}
                                    </div>
                                )}


                                {/* 2. 현재 선택된 소스 요약 및 중복 제거 옵션 */}
                                <div className="mt-8 pt-6 border-t border-zinc-200">
                                    <h3 className="text-lg font-bold text-zinc-800 mb-4">현재 데이터 통합 현황</h3>
                                    <div className="flex space-x-4 mb-6">
                                        <p className={`px-4 py-2 rounded-full text-sm font-semibold ${selectedExistingGroups.length > 0 ? 'bg-emerald-100 text-emerald-700' : 'bg-zinc-100 text-zinc-500'}`}>
                                            기존 그룹: {selectedExistingGroups.length}개 선택
                                        </p>
                                        <p className={`px-4 py-2 rounded-full text-sm font-semibold ${newDataSourceInfo ? 'bg-indigo-100 text-indigo-700' : 'bg-zinc-100 text-zinc-500'}`}>
                                            새 데이터: {newDataSourceInfo ? `${newDataSourceInfo.sourceType === 'upload' ? '업로드' : '검색'} 준비 완료 (${newDataSourceInfo.count}개)` : '미선택'}
                                        </p>
                                    </div>

                                    {/* 🚨 중복 제거 옵션 UI (조건부 렌더링) */}
                                    {isDeduplicationRelevant && (
                                        <div className="mt-6 p-4 border-2 border-orange-300 bg-orange-50 rounded-xl">
                                            <div className="flex items-center justify-between border-b pb-2 mb-3">
                                                <div className="flex items-center gap-2">
                                                    <AlertTriangle className="w-5 h-5 text-orange-600" />
                                                    <h4 className="font-bold text-orange-800">데이터 중복 제거 옵션</h4>
                                                </div>
                                                {/* 중복 제거 토글 */}
                                                <label htmlFor="dedup-toggle" className="flex items-center cursor-pointer">
                                                    <span className="mr-3 text-sm font-medium text-zinc-700">
                                                        {deduplicationEnabled ? '중복 제거 사용 중' : '중복 제거 비활성화'}
                                                    </span>
                                                    <input
                                                        type="checkbox"
                                                        id="dedup-toggle"
                                                        checked={deduplicationEnabled}
                                                        onChange={(e) => setDeduplicationEnabled(e.target.checked)}
                                                        className="sr-only peer"
                                                    />
                                                    {/* Custom Toggle Switch UI */}
                                                    <div className="relative w-11 h-6 bg-orange-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-orange-300 rounded-full peer dark:bg-zinc-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-zinc-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-zinc-600 peer-checked:bg-orange-600"></div>
                                                </label>
                                            </div>

                                            {/* 커스텀 키 선택 필수 영역 */}
                                            {isCustomSelectionRequired && deduplicationEnabled && (
                                                <div className="space-y-2 mb-3">
                                                    <label className="text-sm font-medium text-zinc-700">중복 제거 기준 컬럼 선택:</label>
                                                    <div className="flex flex-wrap gap-2 p-3 bg-white border rounded-lg">
                                                        {newDataSourceInfo?.fileHeaders?.map((header) => (
                                                            <button
                                                                key={header}
                                                                onClick={() => {
                                                                    setCustomDedupKeys(prev => {
                                                                        if (prev.includes(header)) {
                                                                            return prev.filter(k => k !== header);
                                                                        } else {
                                                                            return [...prev, header];
                                                                        }
                                                                    });
                                                                }}
                                                                className={`px-3 py-1 text-xs font-medium rounded-full transition-all ${customDedupKeys.includes(header)
                                                                    ? 'bg-blue-600 text-white shadow-md'
                                                                    : 'bg-zinc-200 text-zinc-700 hover:bg-zinc-300'
                                                                    }`}
                                                            >
                                                                {header}
                                                            </button>
                                                        ))}
                                                    </div>
                                                    {customDedupKeys.length === 0 && (
                                                        <p className="text-xs text-red-500 mt-1">⚠️ 중복 제거를 활성화하려면 기준 컬럼을 최소 하나 선택해야 합니다.</p>
                                                    )}
                                                </div>
                                            )}

                                            {/* 안내 메시지 */}
                                            <p className="text-sm text-orange-700">
                                                기준: **{newDataSourceInfo?.standardDedupKey || (customDedupKeys.length > 0 ? customDedupKeys.join(', ') : '미정')}** 필드 기준 중복 처리됩니다.
                                            </p>

                                            {!deduplicationEnabled && (
                                                <p className="text-sm text-red-700 mt-2 font-semibold">
                                                    ❗ 중복 제거를 비활성화하면, 기존 데이터와 새 데이터가 중복 레코드를 포함하여 그대로 통합됩니다.
                                                </p>
                                            )}
                                        </div>
                                    )}

                                    {/* 3. 다음 단계 버튼 */}
                                    <div className="flex justify-end mt-8">
                                        <button
                                            className="px-6 py-3 bg-indigo-500 text-white rounded-xl shadow-lg hover:bg-indigo-600 disabled:opacity-50 disabled:cursor-not-allowed font-semibold transition-all flex items-center gap-2"
                                            onClick={handleDataPreparationComplete}
                                            disabled={!isNextStepEnabled || trainLoading}
                                        >
                                            {trainLoading ? <Loader2 size={18} className="animate-spin" /> : <ArrowRight size={18} />}
                                            데이터 준비 완료 및 다음 단계로
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    )}


                    {currentStep === 2 && (
                        <div className="bg-white rounded-2xl shadow-xl border border-zinc-100 overflow-hidden">
                            {/* Training Configuration Section */}
                            <div className="bg-white rounded-2xl shadow-xl border border-zinc-100 overflow-hidden">
                                {/* Card Header */}
                                <div className="bg-gradient-to-r from-blue-600 to-indigo-600 px-8 py-6">
                                    <div className="flex items-center gap-3">
                                        <Settings className="w-6 h-6 text-white" />
                                        <h2 className="text-xl font-semibold text-white">학습 파라미터</h2>
                                    </div>
                                    <p className="text-blue-100 text-sm mt-2">
                                        프로젝트 #{project_id}
                                    </p>
                                </div>

                                {/* Form Content */}
                                <div className="p-8 space-y-6">
                                    {/* Info Box */}
                                    <div className="bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-100 rounded-xl p-4">
                                        <div className="flex items-start gap-3">
                                            <Info className="w-5 h-5 text-blue-600 mt-0.5 flex-shrink-0" />
                                            <div>
                                                <p className="text-sm font-semibold text-blue-900 mb-1">학습 안내</p>
                                                <p className="text-xs text-blue-800 leading-relaxed">
                                                    학습 시작 후 모델 관리 페이지에서 진행 상황을 확인할 수 있습니다.
                                                    적절한 하이퍼파라미터 설정은 모델 성능에 큰 영향을 미칩니다.
                                                </p>
                                            </div>
                                        </div>
                                    </div>

                                    {/* Model Info Section */}
                                    <div className="space-y-4">
                                        <h3 className="text-lg font-semibold text-zinc-900 flex items-center gap-2">
                                            <div className="w-1 h-5 bg-gradient-to-b from-blue-600 to-indigo-600 rounded-full" />
                                            모델 정보
                                        </h3>

                                        <div className="grid gap-4">
                                            <div>
                                                <label className="block text-sm font-semibold text-zinc-700 mb-2">
                                                    모델명 *
                                                </label>
                                                <input
                                                    type="text"
                                                    value={modelName}
                                                    onChange={(e) => setModelName(e.target.value)}
                                                    placeholder="예) 특허분류모델_v1"
                                                    className="w-full px-4 py-3 border-2 border-zinc-200 rounded-xl 
                                                focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-100
                                                transition-all shadow-sm hover:shadow-md"
                                                />
                                            </div>

                                            <div>
                                                <label className="block text-sm font-semibold text-zinc-700 mb-2">
                                                    모델 설명
                                                </label>
                                                <textarea
                                                    value={modelDesc}
                                                    onChange={(e) => setModelDesc(e.target.value)}
                                                    placeholder="모델에 대한 간단한 설명을 입력하세요"
                                                    rows={3}
                                                    className="w-full px-4 py-3 border-2 border-zinc-200 rounded-xl 
                                                focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-100
                                                transition-all shadow-sm hover:shadow-md resize-none"
                                                />
                                            </div>
                                        </div>
                                    </div>

                                    {/* Hyperparameters Section */}
                                    <div className="space-y-4">
                                        <h3 className="text-lg font-semibold text-zinc-900 flex items-center gap-2">
                                            <div className="w-1 h-5 bg-gradient-to-b from-blue-600 to-indigo-600 rounded-full" />
                                            하이퍼파라미터
                                        </h3>

                                        <div className="grid md:grid-cols-2 gap-4">
                                            <div>
                                                <label className="block text-sm font-semibold text-zinc-700 mb-2">
                                                    Epoch
                                                </label>
                                                <input
                                                    type="number"
                                                    value={epoch}
                                                    onChange={(e) => setEpoch(Number(e.target.value))}
                                                    className="w-full px-4 py-3 border-2 border-zinc-200 rounded-xl 
                                                focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-100
                                                transition-all shadow-sm hover:shadow-md"
                                                />
                                                <p className="text-xs text-zinc-500 mt-1">학습 반복 횟수</p>
                                            </div>

                                            <div>
                                                <label className="block text-sm font-semibold text-zinc-700 mb-2">
                                                    Batch Size
                                                </label>
                                                <input
                                                    type="number"
                                                    value={batchSize}
                                                    onChange={(e) => setBatchSize(Number(e.target.value))}
                                                    className="w-full px-4 py-3 border-2 border-zinc-200 rounded-xl 
                                                focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-100
                                                transition-all shadow-sm hover:shadow-md"
                                                />
                                                <p className="text-xs text-zinc-500 mt-1">배치 크기</p>
                                            </div>

                                            <div>
                                                <label className="block text-sm font-semibold text-zinc-700 mb-2">
                                                    Learning Rate
                                                </label>
                                                <input
                                                    type="number"
                                                    step="0.00001"
                                                    value={learningRate}
                                                    onChange={(e) => setLearningRate(Number(e.target.value))}
                                                    className="w-full px-4 py-3 border-2 border-zinc-200 rounded-xl 
                                                focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-100
                                                transition-all shadow-sm hover:shadow-md"
                                                />
                                                <p className="text-xs text-zinc-500 mt-1">학습률</p>
                                            </div>

                                            <div>
                                                <label className="block text-sm font-semibold text-zinc-700 mb-2">
                                                    Max Length
                                                </label>
                                                <input
                                                    type="number"
                                                    value={maxLength}
                                                    onChange={(e) => setMaxLength(Number(e.target.value))}
                                                    className="w-full px-4 py-3 border-2 border-zinc-200 rounded-xl 
                                                focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-100
                                                transition-all shadow-sm hover:shadow-md"
                                                />
                                                <p className="text-xs text-zinc-500 mt-1">최대 토큰 길이</p>
                                            </div>
                                        </div>
                                    </div>

                                    {/* Data Options Section */}
                                    <div className="space-y-4">
                                        <h3 className="text-lg font-semibold text-zinc-900 flex items-center gap-2">
                                            <div className="w-1 h-5 bg-gradient-to-b from-blue-600 to-indigo-600 rounded-full" />
                                            데이터 옵션
                                        </h3>

                                        <div>
                                            <label className="block text-sm font-semibold text-zinc-700 mb-3">
                                                데이터 섞기 (Shuffle)
                                            </label>
                                            <div className="flex gap-4">
                                                <label className="flex items-center gap-3 px-6 py-3 border-2 rounded-xl cursor-pointer transition-all hover:bg-blue-50"
                                                    style={{
                                                        borderColor: shuffle ? '#3b82f6' : '#e4e4e7',
                                                        backgroundColor: shuffle ? '#eff6ff' : 'white'
                                                    }}
                                                >
                                                    <input
                                                        type="radio"
                                                        name="shuffle"
                                                        checked={shuffle === true}
                                                        onChange={() => setShuffle(true)}
                                                        className="w-4 h-4 text-blue-600"
                                                    />
                                                    <span className="font-medium text-zinc-900">활성화</span>
                                                </label>
                                                <label className="flex items-center gap-3 px-6 py-3 border-2 rounded-xl cursor-pointer transition-all hover:bg-zinc-50"
                                                    style={{
                                                        borderColor: !shuffle ? '#3b82f6' : '#e4e4e7',
                                                        backgroundColor: !shuffle ? '#eff6ff' : 'white'
                                                    }}
                                                >
                                                    <input
                                                        type="radio"
                                                        name="shuffle"
                                                        checked={shuffle === false}
                                                        onChange={() => setShuffle(false)}
                                                        className="w-4 h-4 text-blue-600"
                                                    />
                                                    <span className="font-medium text-zinc-900">비활성화</span>
                                                </label>
                                            </div>
                                            <p className="text-xs text-zinc-500 mt-2">학습 데이터를 무작위로 섞어 학습 성능을 향상시킵니다</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            {/* Action Buttons */}
                            <div className="flex justify-between items-center">
                                <button
                                    onClick={() => setCurrentStep(1)}
                                    disabled={trainLoading || status}
                                    className="px-6 py-3 bg-zinc-200 text-zinc-700 rounded-xl hover:bg-zinc-300 disabled:opacity-50 disabled:cursor-not-allowed font-medium transition-all flex items-center gap-2"
                                >
                                    <ArrowLeft size={18} />
                                    이전 단계
                                </button>

                                <button
                                    onClick={handleSubmit}
                                    disabled={trainLoading || status || !modelName.trim()}
                                    className="px-8 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-bold rounded-xl 
                                hover:from-blue-700 hover:to-indigo-700
                                disabled:from-zinc-300 disabled:to-zinc-400 disabled:cursor-not-allowed
                                transition-all shadow-lg hover:shadow-xl
                                flex items-center gap-2"
                                >
                                    {trainLoading ? (
                                        <>
                                            <Loader2 size={20} className="animate-spin" />
                                            <span>학습 시작 중...</span>
                                        </>
                                    ) : (
                                        <>
                                            <Zap size={20} />
                                            <span>학습 시작</span>
                                        </>
                                    )}
                                </button>
                            </div>

                        </div>
                    )}

                </div>
            </div>
        </ProjectLayout>
    );
}