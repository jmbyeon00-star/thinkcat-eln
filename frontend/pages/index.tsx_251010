// pages/index.tsx
import { useState } from 'react';

import Head from 'next/head';
import { SearchBar } from '@components/search/SearchBar';
import { SearchResults } from '@components/search/SearchResults';
import { searchPatents } from '@lib/api';
import { SearchResp } from '@lib/types';


export default function Home() {
    const [query, setQuery] = useState('');
    const [loading, setLoading] = useState(false);
    const [resp, setResp] = useState<SearchResp | null>(null);
    const [page, setPage] = useState(1);
    const [lastQuery, setLastQuery] = useState<{keyword: string; category: string} | null>(null);
    const size = 10;

  const handleSearch = async ({ keyword, category }: { keyword: string; category: string }) => {
    setLoading(true);
    setPage(1);
    setLastQuery({ keyword, category });
    try {
      const r = await searchPatents({ keyword, category, page: 1, size });
      console.log("rrr:", r)
      setResp(r);
    } catch (e:any) {
      console.error(e);
      setResp(null);
      alert(e.message);
    } finally {
      setLoading(false);
    }
  };

  const changePage = async (nextPage: number) => {
    if (!lastQuery) return;
    setLoading(true);
    setPage(nextPage);
    try {
      const r = await searchPatents({ ...lastQuery, page: nextPage, size });
      setResp(r);
    } catch (e:any) {
      console.error(e);
      alert(e.message);
    } finally {
      setLoading(false);
    }
  };

  return (
    <>
      <Head>
        <title>IPFORCE 메인</title>
        <meta name="description" content="IPFORCE 프로젝트 메인 페이지" />
      </Head>

      <section style={{ padding: '4rem 2rem', textAlign: 'center' }}>
        <h1 style={{ fontSize: '2.5rem', fontWeight: 'bold' }}>
          Welcome to <span style={{ color: '#1e5aa8' }}>IPFORCE</span>
        </h1>
        <p style={{ marginTop: '1rem', fontSize: '1.1rem', color: '#555' }}>
          AI 기반 R&D, Product, Service 솔루션을 제공합니다.
        </p>
         {/* 검색창 */}
         {/* <form 
          onSubmit={handleSearch} 
          style={{ marginTop: '2rem', display: 'flex', justifyContent: 'center' }}
        >
          <input
            type="text"
            value={query}
            onChange={(e) => setQuery(e.target.value)}
            placeholder="검색어를 입력하세요..."
            style={{
              width: '300px',
              padding: '0.75rem 1rem',
              border: '2px solid #1e5aa8',
              borderRadius: '9999px 0 0 9999px',
              outline: 'none',
              fontSize: '1rem',
            }}
          />
          <button
            type="submit"
            style={{
              padding: '0.75rem 1.5rem',
              border: 'none',
              backgroundColor: '#1e5aa8',
              color: 'white',
              fontWeight: 'bold',
              borderRadius: '0 9999px 9999px 0',
              cursor: 'pointer',
              fontSize: '1rem',
            }}
          >
            검색
          </button>
        </form> */}
        <SearchBar loading={loading} onSearch={handleSearch} />
        <SearchResults resp={resp} page={page} loading={loading} onChangePage={changePage} />
      </section>
    </>
  );
}
