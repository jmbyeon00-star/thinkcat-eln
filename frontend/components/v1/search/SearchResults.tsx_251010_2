// components/SearchResults.tsx
import Link from "next/link";
import { SearchResp } from "@lib/types";

type Props = {
  resp: SearchResp | null;
  loading?: boolean;
};

export default function SearchResults({ resp, loading }: Props) {
  if (!resp) return null;
  if (loading) return <div>검색 중입니다...</div>;

  const keyword = resp.keyword || "";   // 백엔드에서 내려주는 검색어
  const category = resp.category || "a";

  return (
    <div className="max-w-4xl mx-auto text-left">
      <div className="text-gray-600 mb-3">
        검색결과: {resp.total.toLocaleString()}건
      </div>

      {resp.data.map((row) => (
        <Link
          key={row.application_number}
          href={`/search/detail?keyword=${encodeURIComponent(keyword)}&category=${encodeURIComponent(category)}`}
          className="block border border-gray-200 rounded-lg p-4 mb-3 bg-white hover:bg-gray-50 transition"
        >
          <div className="text-sm text-gray-500">{row.application_number}</div>
          <div className="text-lg font-semibold text-blue-700 mt-1">
            {row.title || "(제목 없음)"}
          </div>
          <p className="text-gray-600 text-sm mt-1 line-clamp-2">
            {row.abstract || ""}
          </p>
        </Link>
      ))}
    </div>
  );
}
