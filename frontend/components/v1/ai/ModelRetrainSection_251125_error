                                                    stroke="#6b7280"
                                                />
                                                <YAxis
                                                    label={{ value: 'Accuracy', angle: -90, position: 'insideLeft' }}
                                                    stroke="#6b7280"
                                                />
                                                <Tooltip
                                                    contentStyle={{
                                                        backgroundColor: 'white',
                                                        border: '1px solid #e5e7eb',
                                                        borderRadius: '8px',
