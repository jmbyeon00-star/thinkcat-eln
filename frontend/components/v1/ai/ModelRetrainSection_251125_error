                                                        const { cx, cy, payload } = dotProps;
                                                        return (
                                                            <circle
                                                                cx={cx}
                                                                cy={cy}
                                                                r={4}
                                                                fill={payload.color}
                                                            />
                                                        )
                                                    }}
                                                />
                                                <Line
                                                    type="monotone"
                                                    dataKey="valid_acc"
                                                    stroke="#0ea5e9"
                                                    strokeWidth={2}
                                                    name="Valid Accuracy"
                                                    // dot={{ fill: '#0ea5e9', r: 3 }}
                                                    dot={(dotProps) => {
