                                                <button
                                                    key={page}
                                                    onClick={() => setMappingPage(page)}
                                                    className={`w-8 h-8 rounded-lg text-sm font-medium transition-colors ${page === mappingPage
                                                        ? 'bg-blue-600 text-white'
                                                        : 'hover:bg-zinc-100 text-zinc-700'
                                                        }`}
                                                >
