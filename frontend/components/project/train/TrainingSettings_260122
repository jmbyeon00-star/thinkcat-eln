// frontend/components/project/train/TrainingSetting.tsx

import React, { useCallback, useEffect, useMemo, useState } from "react";
import { AlertCircle, ChevronLeft, ChevronRight, ChevronUp, ChevronDown, Check, CheckCircle, Database, Loader2, Play, Plus, Settings, Trash2, X, } from 'lucide-react';
import { ProjectData, ProjectInfo, ProjectDataGroups, DataSummary, TrainingConfig, DataSourceInfo } from "@/types/project";
import { useCollectionActions } from "@/hooks/project/useCollectionActions";
import AddCollectionModal from "@/components/collection/AddCollectionModal";
import { CollectionInfo } from "@/types/collection";
import { ProjectGroupItems } from "@/types/project";
import SearchComponent from "../SearchComponent";
import UploadComponent from "../UploadComponent";

// Step Enum 정의 (메인 파일과 동일하게 유지)
export enum Step {
    DATA_SELECTION = 1,
    TRAINING_CONFIG = 2,
    REVIEW_AND_START = 3,
}
export const MAX_STEP = 3;

// ----------------------------------------------------
// 1. 좌측 사이드바 (Step Sidebar) 컴포넌트
// ----------------------------------------------------
interface StepSidebarProps {
    currentStep: Step;
    setCurrentStep: (step: Step) => void;
    totalSteps: number;
}

export const StepSidebar: React.FC<StepSidebarProps> = ({ currentStep, setCurrentStep, totalSteps }) => {
    const steps = [
        { id: Step.DATA_SELECTION, name: "데이터 선택", icon: Database },
        { id: Step.TRAINING_CONFIG, name: "학습 설정", icon: Settings },
        { id: Step.REVIEW_AND_START, name: "검토 및 시작", icon: Play },
    ];

    const progress = Math.round(((currentStep - 1) / (totalSteps - 1)) * 100);

    return (
        <div className="lg:w-1/4 w-full bg-white lg:bg-gray-50 lg:p-0 p-4 rounded-xl lg:rounded-none lg:border-r lg:shadow-none shadow-lg mb-6 lg:mb-0">

            {/* 데스크톱 헤더 */}
            <div className="hidden lg:block p-6 border-b border-gray-200">
                <h2 className="text-xl font-bold text-gray-900">새 학습 작업 설정</h2>
                <div className="w-full bg-gray-200 rounded-full h-1.5 mt-3">
                    <div
                        className="bg-indigo-600 h-1.5 rounded-full transition-all duration-500"
                        style={{ width: `${progress}%` }}
                    />
                </div>
            </div>

            {/* 모바일 진행률 표시 */}
            <div className="lg:hidden w-full mb-4">
                <h3 className="text-lg font-semibold text-gray-700 mb-2">Step {currentStep}/{totalSteps}: {steps.find(s => s.id === currentStep)?.name}</h3>
                <div className="w-full bg-gray-200 rounded-full h-2">
                    <div
                        className="bg-indigo-600 h-2 rounded-full transition-all duration-500"
                        style={{ width: `${progress}%` }}
                    />
                </div>
            </div>

            {/* 단계 목록 */}
            <ol className="space-y-1 lg:space-y-2 p-0 lg:p-6">
                {steps.map((step) => {
                    const isCurrent = step.id === currentStep;
                    const isCompleted = step.id < currentStep;
                    const isClickable = step.id <= currentStep;

                    return (
                        <li key={step.id}>
                            <button
                                onClick={() => isClickable && setCurrentStep(step.id)}
                                disabled={!isClickable}
                                className={`flex items-center w-full py-2 px-3 rounded-lg text-left transition-colors font-medium ${isCurrent
                                    ? 'bg-indigo-600 text-white shadow-md'
                                    : isCompleted
                                        ? 'text-gray-700 hover:bg-indigo-50 hover:text-indigo-600'
                                        : 'text-gray-400 cursor-default'
                                    }`}
                            >
                                <span className={`text-sm mr-3 font-bold ${isCurrent ? 'text-white' : isCompleted ? 'text-indigo-600' : 'text-gray-400'}`}>
                                    {step.id}
                                </span>
                                <span className={`${isCurrent ? 'text-white' : 'text-inherit'}`}>
                                    {step.name}
                                </span>
                                {isCompleted && (
                                    <CheckCircle className={`w-4 h-4 ml-auto ${isCurrent ? 'text-white' : 'text-indigo-600'}`} />
                                )}
                            </button>
                        </li>
                    );
                })}
            </ol>
        </div>
    );
};

// ----------------------------------------------------
// Step 1: 데이터 선택 컴포넌트 (데이터 소실 및 중복 완벽 해결본)
// ----------------------------------------------------
export const Step1Content: React.FC<{
    modelInfo: any,
    collectionInfo: CollectionInfo[],
    projectInfo: ProjectInfo,
    token: string;
    dataSummary: DataSummary | null;
    correctDataItems: ProjectData[],
    counterDataItems: ProjectData[], // 👈 부모로부터 반드시 받아야 함
    onSelect: (data: DataSummary) => void,
    onRefreshCollections: () => Promise<void>,
    onNext: () => void,
    canProceed: boolean,
    projectDataGroups: ProjectDataGroups | null;
    totalCount: number,
    perPage: number,
    currentPage: number,
    onPageChange: (page: number) => void,
    onTrainingDataUpdate: (updater: ProjectData[] | ((prev: ProjectData[]) => ProjectData[]), sourceInfo?: any) => void,
    onCounterDataUpdate: (updater: ProjectData[] | ((prev: ProjectData[]) => ProjectData[])) => void
    isEditMode: boolean;
    setIsEditMode: (val: boolean) => void;
}> = ({
    modelInfo, collectionInfo, projectInfo, token, dataSummary,
    correctDataItems = [],
    counterDataItems = [],
    onSelect, onRefreshCollections,
    onNext, canProceed, projectDataGroups, totalCount, perPage, currentPage, onPageChange,
    onTrainingDataUpdate, onCounterDataUpdate,
    isEditMode, setIsEditMode
}) => {
        // --- [1] 상태 및 훅 ---
        const hasExistingModel = modelInfo?.model_list && modelInfo.model_list.length > 0;
        const isCounterUsed = projectInfo?.is_counter_used
        const shouldUseCounter = !hasExistingModel || isCounterUsed;
        console.log("isCounterUsed:", projectInfo)

        const [isAddModalOpen, setIsAddModalOpen] = useState(false);
        const [selectedSources, setSelectedSources] = useState<DataSourceInfo[]>([]);
        const [selectedGroups, setSelectedGroups] = useState<number[]>([]);
        const [isExistingOpen, setIsExistingOpen] = useState(false);
        const [isNewOpen, setIsNewOpen] = useState(false);
        const [uploadedFile, setUploadedFile] = useState<File | null>(null);
        const [reviewTab, setReviewTab] = useState<"train" | "counter">("train");
        const [finalTablePage, setFinalTablePage] = useState(1);
        const FINAL_PER_PAGE = 5;

        const { addCollection, deleteCollections, isActionLoading } = useCollectionActions(
            projectInfo.id, token, onRefreshCollections
        );

        // --- [2] 핵심 유틸리티: 식별자 (모든 데이터의 '키'를 통일해야 소실되지 않음) ---
        const getItemId = useCallback((item: any) => {
            if (!item) return `empty-${Math.random()}`;
            // 출원번호가 있으면 번호로, 없으면 제목+요약 조합으로 고유 키 생성
            const appId = item.application_number?.toString().trim();
            if (appId) return `APP_${appId}`;
            return `TXT_${item.title?.trim()}_${item.abstract?.trim()}`;
        }, []);

        const getIsDuplicate = (a: any, b: any) => getItemId(a) === getItemId(b);

        // --- [3] 통합 데이터 병합 로직 (UPSERT 방식) ---

        // ① 검색/업로드 추가 (학습 우선, 카운터 제거)
        const handleTrainingDataAddition = useCallback((newItems: any[], sourceInfo: DataSourceInfo) => {
            // 🚀 1. 카운터 데이터에서 중복되는 것들 먼저 제거 (상호 배타)
            onCounterDataUpdate(prev => prev.filter(cItem =>
                !newItems.some(newItem => getIsDuplicate(cItem, newItem))
            ));

            // 🚀 2. 학습 데이터에 병합 (기존 prev를 Map으로 유지하여 소실 방지)
            onTrainingDataUpdate((prev: ProjectData[]) => {
                const nextMap = new Map(prev.map(item => [getItemId(item), item]));
                newItems.forEach(newItem => {
                    const id = getItemId(newItem);
                    // 검색/업로드(NEW)가 기존 데이터(ORIGINAL)보다 우선함
                    nextMap.set(id, { ...newItem, data_status: 'NEW', source_type: sourceInfo.type, sourceId: sourceInfo.sourceId });
                });
                return Array.from(nextMap.values());
            }, sourceInfo);

            setSelectedSources(prev => {
                if (prev.some(s => s.type === sourceInfo.type && s.name === sourceInfo.name)) return prev;
                return [...prev, sourceInfo];
            });
        }, [onTrainingDataUpdate, onCounterDataUpdate, getItemId]);

        // ② 카운터 데이터 자동 수집 (Deduplication 적용으로 증식 방지)
        const handleCounterDataAddition = useCallback((newCounterItems: any[]) => {
            onCounterDataUpdate((prev: ProjectData[]) => {
                const nextMap = new Map(prev.map(item => [getItemId(item), item]));
                newCounterItems.forEach((newItem) => {
                    // 이미 학습 리스트에 있으면 카운터 스킵
                    if (correctDataItems.some(tItem => getIsDuplicate(tItem, newItem))) return;
                    const id = getItemId(newItem);
                    if (!nextMap.has(id)) {
                        nextMap.set(id, { ...newItem, data_status: 'ORIGINAL' });
                    }
                });
                return Array.from(nextMap.values());
            });
        }, [onCounterDataUpdate, correctDataItems, getItemId]);

        // ③ 그룹 데이터 토글 (데이터 보호 로직 포함)
        const handleGroupToggle = useCallback((group: ProjectGroupItems) => {
            const groupId = group.id;
            const isCurrentlySelected = selectedGroups.includes(groupId);
            setSelectedGroups(prev => isCurrentlySelected ? prev.filter(id => id !== groupId) : [...prev, groupId]);

            if (isCurrentlySelected) {
                // 제거 시 해당 소스 아이디를 가진 데이터만 삭제
                onTrainingDataUpdate(prev => prev.filter(item => item.sourceId !== String(groupId)));
                onCounterDataUpdate(prev => prev.filter(item => item.sourceId !== String(groupId)));
            } else {
                const trainingItems = group.group_items.filter(item => item.used === 1);
                const counterItems = group.group_items.filter(item => item.used === 0);

                onTrainingDataUpdate(prev => {
                    const nextMap = new Map(prev.map(item => [getItemId(item), item]));
                    trainingItems.forEach(gItem => {
                        const id = getItemId(gItem);
                        // ⚠️ 이미 이번 세션의 NEW/EDITED 데이터가 있다면 덮어쓰지 않음 (소실 방지)
                        if (nextMap.has(id)) {
                            const existing = nextMap.get(id);
                            if (existing?.data_status === 'NEW' || existing?.data_status === 'EDITED') return;
                        }
                        nextMap.set(id, { ...gItem, data_status: 'ORIGINAL', source_type: 'group', sourceId: String(groupId) });
                    });
                    return Array.from(nextMap.values());
                });

                onCounterDataUpdate(prev => {
                    const nextMap = new Map(prev.map(item => [getItemId(item), item]));
                    counterItems.forEach(cItem => {
                        const id = getItemId(cItem);
                        if (!nextMap.has(id) && !correctDataItems.some(t => getItemId(t) === id)) {
                            nextMap.set(id, { ...cItem, label: 'COUNTER', data_status: 'ORIGINAL', sourceId: String(groupId) });
                        }
                    });
                    return Array.from(nextMap.values());
                });
            }

            const sourceInfo: DataSourceInfo = { name: group.group_code, count: group.count, type: 'group', sourceId: groupId };
            setSelectedSources(prev => isCurrentlySelected ? prev.filter(s => s.sourceId !== groupId) : [...prev, sourceInfo]);
        }, [selectedGroups, onTrainingDataUpdate, onCounterDataUpdate, correctDataItems, getItemId]);

        // --- [4] 편집 및 계산 로직 ---
        const handleUpdateAllItem = useCallback((targetId: string, field: keyof ProjectData, value: string) => {
            onTrainingDataUpdate(prev => prev.map(item => getItemId(item) === targetId ? { ...item, [field]: value, data_status: 'EDITED' } : item));
            onCounterDataUpdate(prev => prev.map(item => getItemId(item) === targetId ? { ...item, [field]: value, data_status: 'EDITED' } : item));
        }, [onTrainingDataUpdate, onCounterDataUpdate, getItemId]);


        const activeItems = useMemo(() => { return reviewTab === "train" ? correctDataItems : counterDataItems; }, [reviewTab, correctDataItems, counterDataItems]);
        const totalFinalPages = Math.max(1, Math.ceil(activeItems.length / FINAL_PER_PAGE));
        const currentFinalItems = useMemo(() => activeItems.slice((finalTablePage - 1) * FINAL_PER_PAGE, finalTablePage * FINAL_PER_PAGE), [activeItems, finalTablePage]);

        // const allCombinedItems = useMemo(() => [...correctDataItems, ...counterDataItems], [correctDataItems, counterDataItems]);
        // const totalFinalPages = Math.max(1, Math.ceil(allCombinedItems.length / FINAL_PER_PAGE));
        // const currentFinalItems = useMemo(() => allCombinedItems.slice((finalTablePage - 1) * FINAL_PER_PAGE, finalTablePage * FINAL_PER_PAGE), [allCombinedItems, finalTablePage]);

        const collectionStatus = useMemo(() => {
            const safeCollections = collectionInfo || [];
            const defined = safeCollections.map(coll => {
                const count = correctDataItems.filter(item => (item.label?.trim() === coll.collection_name.trim()) || (item.collection_name?.trim() === coll.collection_name.trim())).length;
                return { id: coll.id, code: coll.collection_code, name: coll.collection_name, count, isSatisfied: count >= 10 };
            });
            const definedNames = new Set(safeCollections.map(c => c.collection_name.trim()));
            const undefinedMap = new Map<string, number>();
            correctDataItems.forEach(item => {
                const label = (item.label || item.collection_name)?.trim();
                if (label && !definedNames.has(label)) undefinedMap.set(label, (undefinedMap.get(label) || 0) + 1);
            });
            return { defined, undefinedLabels: Array.from(undefinedMap.entries()).map(([name, count]) => ({ name, count })) };
        }, [collectionInfo, correctDataItems]);

        const liveSummary = useMemo(() => {
            const registeredNames = new Set((collectionInfo || []).map(c => c.collection_name.trim()));
            const validDataItems = correctDataItems.filter(item => registeredNames.has((item.label || item.collection_name || "").trim()));
            const isAllSatisfied = collectionStatus.defined.length > 0 && collectionStatus.defined.every(s => s.isSatisfied);
            return { totalItemsCount: validDataItems.length, sourceList: selectedSources, isValid: validDataItems.length > 0 && isAllSatisfied && collectionStatus.undefinedLabels.length === 0 };
        }, [selectedSources, correctDataItems, collectionStatus, collectionInfo]);

        useEffect(() => { if (collectionInfo) onSelect(liveSummary); }, [liveSummary, onSelect, collectionInfo]);
        useEffect(() => { if (finalTablePage > totalFinalPages && totalFinalPages > 0) setFinalTablePage(totalFinalPages); }, [totalFinalPages, finalTablePage]);

        const handleRemoveSource = (source: DataSourceInfo) => {
            setSelectedSources(prev => prev.filter(s => !(s.type === source.type && s.sourceId === source.sourceId)));
            if (source.type === "group") setSelectedGroups(prev => prev.filter(id => id !== source.sourceId));
            onTrainingDataUpdate(prev => prev.filter(item => item.sourceId !== source.sourceId));
            onCounterDataUpdate(prev => prev.filter(item => item.sourceId !== source.sourceId));
        };

        const handleRemoveDataByLabel = (labelName: string) => {
            if (!confirm(`'${labelName}' 레이블 데이터를 삭제하시겠습니까?`)) return;
            const target = labelName.trim().toLowerCase();
            onTrainingDataUpdate(prev => prev.filter(i => (i.label || i.collection_name || "").toString().trim().toLowerCase() !== target));
            onCounterDataUpdate(prev => prev.filter(i => (i.label || i.collection_name || "").toString().trim().toLowerCase() !== target));
        };

        const handleRemoveDataItem = useCallback((targetId: string, type: "train" | "counter") => {
            if (!confirm("이 데이터를 삭제하시겠습니까?")) return;

            if (type === "train") {
                onTrainingDataUpdate(prev => prev.filter(item => getItemId(item) !== targetId));
            } else {
                onCounterDataUpdate(prev => prev.filter(item => getItemId(item) !== targetId));
            }
        }, [onTrainingDataUpdate, onCounterDataUpdate, getItemId]);


        // --- [5] UI 렌더링 영역 ---
        const AccordionItem: React.FC<{ title: string; description: string; children: React.ReactNode; isOpen: boolean; setIsOpen: (open: boolean) => void; isUsed: boolean; setIsUsed: (used: boolean) => void; }> = ({ title, description, children, isOpen, setIsOpen, isUsed, setIsUsed }) => (
            <div className="border border-gray-200 rounded-xl shadow-sm overflow-hidden mb-3">
                <div className={`flex items-center justify-between p-4 cursor-pointer transition-colors ${isUsed ? 'bg-indigo-50/40' : 'bg-white'}`} onClick={() => setIsOpen(!isOpen)}>
                    <div><h4 className="text-sm font-black text-gray-800">{title}</h4><p className="text-[11px] text-gray-500 mt-0.5 font-medium">{description}</p></div>
                    {isOpen ? <ChevronUp size={18} className="text-gray-400" /> : <ChevronDown size={18} className="text-gray-400" />}
                </div>
                {isOpen && <div className="p-4 bg-white border-t border-gray-100">{children}</div>}
            </div>
        );

        return (
            <div className="space-y-6">
                <h3 className="text-xl font-black text-gray-900 flex items-center gap-2"><Database className="text-indigo-600" size={24} /> 데이터 소스 구성</h3>

                <div className="space-y-3">
                    <AccordionItem title="📦 기존 프로젝트 데이터 그룹" description={`총 ${totalCount}개 그룹 선택 가능`} isOpen={isExistingOpen} setIsOpen={(v) => { setIsExistingOpen(v); if (v) setIsNewOpen(false); }} isUsed={selectedGroups.length > 0} setIsUsed={(used) => setSelectedGroups(used && projectDataGroups ? projectDataGroups.groups.map(g => g.id) : [])}>
                        <div className="grid gap-2 sm:grid-cols-2">
                            {projectDataGroups?.groups.map(group => (
                                <div key={group.id} onClick={() => handleGroupToggle(group)} className={`flex items-center justify-between p-3 rounded-xl border-2 transition-all cursor-pointer ${selectedGroups.includes(group.id) ? 'border-indigo-500 bg-indigo-50' : 'border-zinc-100 hover:border-zinc-200'}`}>
                                    <div className="flex items-center gap-3"><input type="checkbox" checked={selectedGroups.includes(group.id)} readOnly className="h-4 w-4 text-indigo-600 rounded" /><div><p className="text-xs font-bold text-zinc-800">{group.group_code}</p><p className="text-[10px] text-zinc-500">{group.count}건</p></div></div>
                                </div>
                            ))}
                        </div>
                    </AccordionItem>

                    <AccordionItem title="➕ 새로운 데이터 추가/병합" description="검색 또는 파일 업로드 데이터" isOpen={isNewOpen} setIsOpen={(v) => { setIsNewOpen(v); if (v) setIsExistingOpen(false); }} isUsed={dataSummary?.sourceList?.some(src => src.type === "search" || src.type === "upload") ?? false} setIsUsed={(used) => { if (!used && uploadedFile) setUploadedFile(null); }}>
                        {projectInfo.source_type === "search" ? <SearchComponent project={projectInfo} token={token} collections={collectionInfo} shouldUseCounter={!!shouldUseCounter} correctDataItems={correctDataItems} onTrainingDataUpdate={handleTrainingDataAddition} onCounterDataUpdate={handleCounterDataAddition} /> : <UploadComponent project={projectInfo} token={token} collections={collectionInfo} onTrainingDataUpdate={handleTrainingDataAddition} />}
                    </AccordionItem>
                </div>

                {/* 📊 컬렉션 현황판 */}
                <div className="p-6 bg-zinc-50 border border-zinc-200 rounded-2xl space-y-4">
                    <div className="flex justify-between items-center"><h4 className="text-lg font-bold text-zinc-800 flex items-center gap-2">학습 데이터 구성 현황</h4>{!hasExistingModel && <button onClick={() => setIsEditMode(!isEditMode)} className={`px-3 py-1.5 rounded-lg text-xs font-bold border transition-all ${isEditMode ? 'bg-zinc-800 text-white' : 'bg-white text-zinc-600 hover:bg-zinc-100'}`}>{isEditMode ? '완료' : '컬렉션 편집'}</button>}</div>
                    <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
                        {collectionStatus.defined.map(status => (
                            <div key={status.id} className="relative group bg-white p-4 rounded-xl border-2 border-zinc-100 flex flex-col justify-between h-24">
                                <p className="text-[11px] font-bold text-zinc-500 truncate">{status.name}</p>
                                <div className="flex items-baseline gap-1"><span className={`text-2xl font-black ${status.isSatisfied ? 'text-emerald-600' : 'text-zinc-400'}`}>{status.count}</span><span className="text-[10px] text-zinc-400">/ 10</span></div>
                                <div className="w-full bg-zinc-100 h-1.5 rounded-full overflow-hidden"><div className={`h-full ${status.isSatisfied ? 'bg-emerald-500' : 'bg-amber-400'}`} style={{ width: `${Math.min((status.count / 10) * 100, 100)}%` }} /></div>
                                {isEditMode &&
                                    <button onClick={() =>
                                        // deleteCollections([{ id: status.id, code: status.code, name: status.name }])} 
                                        deleteCollections([{ id: status.id, code: status.code }])}
                                        className="absolute -top-2 -right-2 bg-red-500 text-white rounded-full p-1 shadow-lg hover:bg-red-600">
                                        <X size={14} />
                                    </button>
                                }
                            </div>
                        ))}
                        <button onClick={() => setIsAddModalOpen(true)} className="h-24 rounded-xl border-2 border-dashed border-zinc-200 flex flex-col items-center justify-center text-zinc-400 hover:bg-indigo-50 transition-all"><Plus size={24} /><span className="text-[10px] font-bold mt-1">새 컬렉션</span></button>
                    </div>
                </div>

                {/* ⚠️ 미등록 레이블 발견 섹션 */}
                {
                    collectionStatus.undefinedLabels.length > 0 && (
                        <div className={`p-4 rounded-xl border-2 shadow-sm ${hasExistingModel ? 'bg-red-50 border-red-200' : 'bg-amber-50 border-amber-200'}`}>
                            <div className="flex justify-between items-center mb-3">
                                <div className={`flex items-center gap-2 font-black text-sm ${hasExistingModel ? 'text-red-700' : 'text-amber-700'}`}><AlertCircle size={20} /><span>{hasExistingModel ? "⚠️ 호환되지 않는 레이블 발견" : `미등록 레이블 발견: ${collectionStatus.undefinedLabels.length}개`}</span></div>
                                <div className="flex gap-2">
                                    {hasExistingModel ? (
                                        <button onClick={() => { if (confirm("모든 미등록 데이터를 삭제하시겠습니까?")) onTrainingDataUpdate(prev => prev.filter(i => collectionInfo.some(c => c.collection_name === (i.label || i.collection_name)))); }} className="px-3 py-1.5 bg-red-600 text-white rounded-lg font-bold text-xs shadow-sm">미등록 데이터 일괄 삭제</button>
                                    ) : (
                                        <button onClick={async () => { if (confirm("모든 미등록 레이블을 등록하시겠습니까?")) for (const u of collectionStatus.undefinedLabels) await addCollection(u.name); }} className="px-3 py-1.5 bg-amber-600 text-white rounded-lg font-bold text-xs shadow-sm">모두 컬렉션으로 등록</button>
                                    )}
                                </div>
                            </div>
                            <div className="flex flex-wrap gap-2">
                                {collectionStatus.undefinedLabels.map(unseen => (
                                    <div key={unseen.name} className="flex items-center gap-2 px-3 py-1.5 bg-white border border-zinc-200 rounded-lg text-xs font-bold shadow-sm">
                                        <span>{unseen.name} ({unseen.count})</span>
                                        {hasExistingModel ? (
                                            <button onClick={() => handleRemoveDataByLabel(unseen.name)} className="text-red-500 hover:bg-red-50 p-0.5 rounded"><X size={14} /></button>
                                        ) : (
                                            <button onClick={() => addCollection(unseen.name)} className="text-indigo-600 hover:bg-indigo-50 p-0.5 rounded"><Plus size={14} /></button>
                                        )}
                                    </div>
                                ))}
                            </div>
                        </div>
                    )
                }

                {/* Selected Sources UI */}
                <div className="p-5 bg-white border border-indigo-100 rounded-2xl shadow-sm space-y-4">
                    <div className="flex justify-between items-center pb-2 border-b border-zinc-50"><h4 className="text-xs font-black text-indigo-900 uppercase tracking-wider">Selected Data Sources</h4><span className="text-[10px] font-black text-indigo-600 bg-indigo-50 px-2 py-1 rounded-full uppercase">Total: {activeItems.length} Records</span></div>
                    {selectedSources.length === 0 ? <p className="text-zinc-400 text-xs text-center py-4">선택된 데이터 소스가 없습니다.</p> : <div className="flex flex-wrap gap-2">{selectedSources.map((s, idx) => <div key={idx} className="flex items-center gap-2 bg-zinc-50 border border-zinc-200 px-3 py-1.5 rounded-xl text-[11px] font-medium text-zinc-700 shadow-sm"><span>{s.name} <strong className="text-indigo-600 ml-1">{s.count}</strong></span><button onClick={() => handleRemoveSource(s)} className="text-zinc-400 hover:text-red-500 p-0.5"><X size={14} /></button></div>)}</div>}
                </div>

                {/* 최종 통합 테이블 */}
                <div className="space-y-4 pt-8 border-t-2 border-zinc-100">
                    <h4 className="text-lg font-black text-zinc-900 flex items-center gap-2"><Check className="text-emerald-500" size={24} /> 데이터 최종 검토 및 편집</h4>

                    <div className="flex bg-zinc-100 p-1 rounded-xl border border-zinc-200">
                        <button
                            onClick={() => { setReviewTab("train"); setFinalTablePage(1); }}
                            className={`px-4 py-1.5 rounded-lg text-xs font-bold transition-all ${reviewTab === "train" ? "bg-white text-indigo-600 shadow-sm" : "text-zinc-500 hover:text-zinc-700"
                                }`}
                        >
                            Train ({correctDataItems.length})
                        </button>
                        <button
                            onClick={() => { setReviewTab("counter"); setFinalTablePage(1); }}
                            className={`px-4 py-1.5 rounded-lg text-xs font-bold transition-all ${reviewTab === "counter" ? "bg-white text-orange-600 shadow-sm" : "text-zinc-500 hover:text-zinc-700"
                                }`}
                        >
                            Counter ({counterDataItems.length})
                        </button>
                    </div>

                    <div className="overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm">
                        <table className="min-w-full divide-y divide-zinc-200">
                            <thead className="bg-zinc-50 font-bold text-[10px] text-zinc-400 uppercase tracking-widest">
                                <tr>
                                    <th className="p-4 text-left w-24">Type</th>
                                    <th className="p-4 text-left w-1/3">Patent Title</th>
                                    <th className="p-4 text-left">Abstract</th>
                                    <th className="p-4 text-left w-24">Label</th>
                                    <th className="p-4 text-center w-16">Action</th>
                                </tr>
                            </thead>
                            <tbody className="divide-y divide-zinc-100 text-sm">
                                {currentFinalItems.map((item) => {
                                    const rowKey = getItemId(item);
                                    const isCounter = item.label === 'COUNTER' || item.collection_name === 'COUNTER';
                                    return (
                                        <tr key={rowKey} className={`hover:bg-indigo-50/20 transition-colors ${isCounter ? 'bg-orange-50/10' : ''}`}>
                                            <td className="p-4"><div className="flex flex-col gap-1 items-start">{isCounter ? <span className="px-1.5 py-0.5 bg-orange-100 text-orange-700 rounded text-[9px] font-black uppercase tracking-tighter">Counter</span> : <span className="px-1.5 py-0.5 bg-indigo-100 text-indigo-700 rounded text-[9px] font-black uppercase tracking-tighter">Train</span>}{item.data_status === 'NEW' && <span className="text-[8px] text-emerald-600 font-black ml-1 tracking-tighter uppercase">● NEW</span>}{item.data_status === 'EDITED' && <span className="text-[8px] text-amber-600 font-black ml-1 tracking-tighter uppercase">● EDITED</span>}</div></td>
                                            <td className="p-4"><input className="w-full bg-transparent border-none focus:ring-1 focus:ring-indigo-500 rounded p-1 text-xs font-bold text-zinc-800" value={item.title || ""} onChange={(e) => handleUpdateAllItem(rowKey, 'title', e.target.value)} /></td>
                                            <td className="p-4"><textarea rows={1} className="w-full bg-transparent border-none focus:ring-1 focus:ring-indigo-500 rounded p-1 text-[11px] text-zinc-500 resize-none overflow-hidden leading-relaxed" value={item.abstract || ""} onChange={(e) => handleUpdateAllItem(rowKey, 'abstract', e.target.value)} /></td>
                                            <td className="p-4"><span className={`text-[11px] font-black ${isCounter ? 'text-orange-500' : 'text-indigo-600'}`}>{item.collection_name || item.label}</span></td>
                                            <td className="p-4 text-center"><button onClick={() => handleRemoveDataItem(rowKey, reviewTab)} className="text-zinc-300 hover:text-red-500 transition-colors p-1"><Trash2 size={16} /></button></td>
                                        </tr>
                                    );
                                })}
                                {currentFinalItems.length === 0 && (
                                    <tr>
                                        <td colSpan={5} className="p-20 text-center text-zinc-400 text-xs">표시할 데이터가 없습니다.</td>
                                    </tr>
                                )}
                            </tbody>
                        </table>
                    </div>
                    {totalFinalPages > 1 && (
                        <div className="flex justify-center items-center gap-6 py-5 bg-zinc-50 rounded-2xl border border-zinc-200">
                            <button onClick={() => setFinalTablePage(p => Math.max(1, p - 1))} disabled={finalTablePage === 1} className="p-2 bg-white rounded-xl shadow-sm border border-zinc-200 disabled:opacity-30 hover:text-indigo-600 transition-all"><ChevronLeft size={20} /></button>
                            <span className="text-sm font-black text-zinc-700">{finalTablePage} <span className="text-zinc-300 mx-2">/</span> {totalFinalPages}</span>
                            <button onClick={() => setFinalTablePage(p => Math.min(totalFinalPages, p + 1))} disabled={finalTablePage === totalFinalPages} className="p-2 bg-white rounded-xl shadow-sm border border-zinc-200 disabled:opacity-30 hover:text-indigo-600 transition-all"><ChevronRight size={20} /></button>
                        </div>
                    )}
                </div>

                {isAddModalOpen && <AddCollectionModal project_id={String(projectInfo.id)} onClose={() => setIsAddModalOpen(false)} onSave={async (name) => { if (collectionInfo.some(c => c.collection_name.trim().toLowerCase() === name.trim().toLowerCase())) { alert("중복된 이름입니다."); return; } const s = await addCollection(name.trim()); if (s) setIsAddModalOpen(false); }} />}
                {isActionLoading && <div className="fixed inset-0 z-[100] flex items-center justify-center bg-white/60 backdrop-blur-sm"><Loader2 className="animate-spin text-indigo-600" size={32} /></div>}
            </div >
        );
    };


// ----------------------------------------------------
// 3. Step 2: 학습 설정 컴포넌트
// ----------------------------------------------------
export const Step2Content: React.FC<{
    dataSummary: DataSummary, onConfigChange: (config: TrainingConfig) => void, onNext: () => void, onBack: () => void, canProceed: boolean
}> = ({ dataSummary, onConfigChange, onNext, onBack, canProceed }) => {

    // TrainingConfig 타입을 사용하여 상태 정의
    const [config, setConfig] = useState<TrainingConfig>({
        modelName: '이름 없음',
        modelDesc: '설명 없음',
        epoch: 10,
        batchSize: 32,
        learningRate: 1e-5,
        maxLength: 128,
        shuffle: true,
    });

    // 설정 변경 시 즉시 상위 컴포넌트로 전달
    useEffect(() => {
        onConfigChange(config);
    }, [config, onConfigChange]);

    const handleInputChange = (e: React.ChangeEvent<HTMLInputElement>) => {
        const { id, value } = e.target;
        setConfig(c => ({
            ...c,
            // id가 'modelName'일 경우 문자열, 아닐 경우 숫자로 변환
            [id]: id === 'modelName' || id === 'modelDesc' ? value : (id === 'learningRate' ? parseFloat(value) : parseInt(value) || 1),
        }));
    };

    return (
        <div className="space-y-6">
            <h3 className="text-xl font-semibold text-gray-800">모델 및 파라미터 정의</h3>
            <p className="text-gray-500">학습에 사용할 모델 이름과 하이퍼파라미터를 설정하세요.</p>

            {/* 1단계 요약 */}
            <div className="bg-gray-100 p-3 rounded-lg text-sm border border-gray-200">
                <p className="font-semibold text-gray-700">
                    선택 데이터:
                    <span className="font-medium text-gray-900">
                        {dataSummary.sourceList.length}개 소스
                    </span>
                    (
                    {dataSummary.totalItemsCount}개
                    )</p>
            </div>

            {/* 설정 폼 */}
            <div className="space-y-4">
                <div>
                    <label htmlFor="modelName" className="block text-sm font-medium text-gray-700">모델 이름</label>
                    <input
                        id="modelName"
                        type="text"
                        value={config.modelName}
                        onChange={handleInputChange}
                        className="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2 focus:ring-indigo-500 focus:border-indigo-500"
                    />
                </div>
                <div>
                    <label htmlFor="modelDesc" className="block text-sm font-medium text-gray-700">모델 설명</label>
                    <input
                        id="modelDesc"
                        type="text"
                        value={config.modelDesc}
                        onChange={handleInputChange}
                        className="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2 focus:ring-indigo-500 focus:border-indigo-500"
                    />
                </div>
                <div className="flex items-center justify-between">
                    <label htmlFor="epoch" className="block text-sm font-medium text-gray-700">학습 횟수(Epoch)</label>
                    <input
                        id="epoch"
                        type="number"
                        min="1"
                        value={config.epoch}
                        onChange={handleInputChange}
                        className="mt-1 block w-1/3 border border-gray-300 rounded-md shadow-sm p-2 focus:ring-indigo-500 focus:border-indigo-500"
                    />
                </div>
                <div className="flex items-center justify-between">
                    <label htmlFor="batchSize" className="block text-sm font-medium text-gray-700">배치 크기(Batch Size)</label>
                    <input
                        id="batchSize"
                        type="number"
                        min="1"
                        value={config.batchSize}
                        onChange={handleInputChange}
                        className="mt-1 block w-1/3 border border-gray-300 rounded-md shadow-sm p-2 focus:ring-indigo-500 focus:border-indigo-500"
                    />
                </div>
                <div className="flex items-center justify-between">
                    <label htmlFor="learningRate" className="block text-sm font-medium text-gray-700">학습률(Learning Rate)</label>
                    <input
                        id="learningRate"
                        type="number"
                        step="any" // 소수점 입력 허용
                        value={config.learningRate}
                        onChange={handleInputChange}
                        className="mt-1 block w-1/3 border border-gray-300 rounded-md shadow-sm p-2 focus:ring-indigo-500 focus:border-indigo-500"
                    />
                </div>
                <div className="flex items-center justify-between">
                    <label htmlFor="learningRate" className="block text-sm font-medium text-gray-700">최대 길이(Max Length)</label>
                    <input
                        id="maxLength"
                        type="number"
                        step="any" // 소수점 입력 허용
                        value={config.maxLength}
                        onChange={handleInputChange}
                        className="mt-1 block w-1/3 border border-gray-300 rounded-md shadow-sm p-2 focus:ring-indigo-500 focus:border-indigo-500"
                    />
                </div>
                <div className="flex items-center justify-between">
                    <label className="text-sm font-medium text-gray-700">데이터 섞기(Shuffle)</label>
                    <button
                        type="button"
                        onClick={() =>
                            setConfig(c => ({ ...c, shuffle: !c.shuffle }))
                        }
                        className={`
                            relative inline-flex h-6 w-11 items-center rounded-full transition-colors
                            ${config.shuffle ? "bg-indigo-600" : "bg-gray-300"}
                        `}
                    >
                        <span
                            className={`
                                inline-block h-4 w-4 transform rounded-full bg-white transition-transform
                                ${config.shuffle ? "translate-x-6" : "translate-x-1"}
                            `}
                        />
                    </button>
                </div>
            </div>

            {/* 모바일용 버튼 */}
            <div className="lg:hidden pt-6 border-t flex justify-between">
                <button
                    onClick={onBack}
                    className="px-6 py-2 border border-gray-300 text-gray-700 font-semibold rounded-lg shadow-sm hover:bg-gray-50 transition-colors"
                >
                    ← 이전
                </button>
                <button
                    onClick={onNext}
                    disabled={!canProceed}
                    className={`px-6 py-2 text-white font-bold rounded-lg shadow-md transition-colors disabled:opacity-50 disabled:cursor-not-allowed bg-indigo-600 hover:bg-indigo-700`}
                >
                    다음 →
                </button>
            </div>
        </div>
    );
};


// ----------------------------------------------------
// 4. Step 3: 검토 및 시작 컴포넌트
// ----------------------------------------------------
export const Step3Content: React.FC<{ dataSummary: DataSummary, config: TrainingConfig, onStart: () => void, onBack: () => void, canProceed: boolean }> = ({ dataSummary, config, onStart, onBack, canProceed }) => {
    const typeLabelMap: Record<string, string> = {
        group: "그룹 데이터",
        upload: "파일 데이터",
        search: "DB 데이터",
    };

    const groupedSources = useMemo(() => {
        return dataSummary.sourceList.reduce((acc, item) => {
            // console.log("acc:", acc, "item:", item)
            if (!acc[item.type]) acc[item.type] = [];
            acc[item.type].push(item);
            return acc;
        }, {} as Record<string, DataSourceInfo[]>);
    }, [dataSummary.sourceList]);

    return (
        <div className="space-y-6">
            <h3 className="text-xl font-semibold text-gray-800">최종 설정 검토</h3>
            <p className="text-gray-500">모든 설정을 확인한 후 학습을 시작해 주세요.</p>

            <div className="space-y-4">
                {/* 데이터 요약 */}
                <div className="p-4 rounded-lg bg-indigo-50 border border-indigo-200">
                    <h4 className="font-bold text-lg text-indigo-700 mb-2">데이터 설정</h4>
                    <div className="ml-2 space-y-1 text-sm text-indigo-800">
                        <p>{dataSummary.totalItemsCount}개</p>
                        <div className="space-y-4">
                            {Object.entries(groupedSources).map(([type, items]) => (
                                <div key={type} className="p-3 border rounded-md bg-gray-50">
                                    <h4 className="font-semibold text-gray-800 mb-2">
                                        {typeLabelMap[type] ?? "기타 데이터"} ({items.length})
                                    </h4>

                                    <ul className="space-y-1 text-sm text-gray-700">
                                        {items.map((item, idx) => (
                                            <li key={idx} className="flex justify-between">
                                                <span>• {item.name}</span>
                                                <span>{item.count}개</span>
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>

                {/* 설정 요약 */}
                <div className="p-4 rounded-lg bg-green-50 border border-green-200">
                    <h4 className="font-bold text-lg text-green-700 mb-2">모델 파라미터</h4>
                    <div className="ml-2 space-y-1 text-sm text-green-800">
                        <p><b>모델 이름:</b> {config.modelName}</p>
                        <p><b>모델 설명:</b> {config.modelDesc}</p>
                        <p><b>학습 횟수(Epoch):</b> {config.epoch}</p>
                        <p><b>학습률(Learning Rate):</b> {config.learningRate}</p>
                        <p><b>배치 크기(Batch Size):</b> {config.batchSize}</p>
                        <p><b>최대 크기(Max Length):</b> {config.maxLength}</p>
                        <p><b>데이터 섞기(Shuffle):</b> {config.shuffle ? "Yes" : "No"}</p>
                    </div>
                </div>
            </div>

            {/* 모바일용 버튼 */}
            <div className="lg:hidden pt-6 border-t flex justify-between">
                <button
                    onClick={onBack}
                    className="px-6 py-2 border border-gray-300 text-gray-700 font-semibold rounded-lg shadow-sm hover:bg-gray-50 transition-colors"
                >
                    ← 이전
                </button>
                <button
                    onClick={onStart}
                    disabled={!canProceed}
                    className={`px-6 py-3 text-white font-bold rounded-lg shadow-xl hover:bg-green-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed bg-green-600`}
                >
                    <Play className="w-5 h-5 mr-2 inline-block" /> 학습 시작하기
                </button>
            </div>
        </div>
    );
};