import { useState } from "react";
import { UploadCloud, FileSpreadsheet, Save, Loader2, ChevronLeft, ChevronRight, Trash2, ArrowRight } from "lucide-react"; // ArrowRight 추가
import * as XLSX from "xlsx";
import { useRouter } from "next/router";

type Project = {
    id: number;
    project_code: string;
    project_name: string;
    project_description?: string;
    source_type: string;
    task_type: string;
    project_status: number;
    created_datetime?: string;
};

type NewDataSourceInfo = {
    sourceType: 'upload';
    fileIds?: number[];
    searchKey?: string;
    standardDedupKey?: string;
    fileHeaders?: string[];
    count?: number;
};

interface UploadComponentProps {
    project: Project;
    token: string;
    userEmail: string;
    // 💡 Prop: 데이터 준비 완료 시 상위 컴포넌트로 결과를 전달하는 핸들러
    onNewDataReady: (dataInfo: NewDataSourceInfo) => void;
    onCancel: () => void;
}

export default function UploadComponent({ project, token, userEmail, onNewDataReady, onCancel }: UploadComponentProps) {
    const router = useRouter();
    const API_BASE = process.env.NEXT_PUBLIC_PUBLIC_API_BASE_URL;

    const [uploading, setUploading] = useState(false);
    const [rows, setRows] = useState<any[]>([]);
    const [preparing, setPreparing] = useState(false);
    const [saving, setSaving] = useState(false);
    const [originalFile, setOriginalFile] = useState<File | null>(null);
    const [hasEdited, setHasEdited] = useState(false);
    const [fileUploadedSuccess, setFileUploadedSuccess] = useState(false);

    console.log("rows:", rows)

    const [currentPage, setCurrentPage] = useState(1);
    const rowsPerPage = 10;
    const totalPages = Math.ceil(rows.length / rowsPerPage);
    const currentRows = rows.slice((currentPage - 1) * rowsPerPage, currentPage * rowsPerPage);

    // 파일 읽기 (프론트 메모리)
    async function handleFileUpload(f: File) {
        setUploading(true);
        setOriginalFile(f);
        setRows([]);
        setFileUploadedSuccess(false);

        const reader = new FileReader();
        reader.onload = (e) => {
            try {
                const data = new Uint8Array(e.target?.result as ArrayBuffer);
                const workbook = XLSX.read(data, { type: "array" });
                const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
                const jsonData = XLSX.utils.sheet_to_json(firstSheet);

                if (jsonData.length === 0) {
                    alert("파일에 내용이 없습니다.");
                    return;
                }

                setRows(jsonData as any[]);
                setCurrentPage(1);
                setHasEdited(false);
                setFileUploadedSuccess(true);
            } catch (e) {
                alert("파일을 읽는 중 오류가 발생했습니다. 파일 형식을 확인해주세요.");
            } finally {
                setUploading(false);
            }
        };
        reader.readAsArrayBuffer(f);
    }

    // 개별 셀 수정
    function updateCell(index: number, key: string, value: string) {
        setHasEdited(true);
        const globalIndex = (currentPage - 1) * rowsPerPage + index;
        setRows((prev) =>
            prev.map((r, i) => (i === globalIndex ? { ...r, [key]: value } : r))
        );
    }

    // 행 삭제
    function handleDelete(index: number) {
        const globalIndex = (currentPage - 1) * rowsPerPage + index;
        setRows((prev) => prev.filter((_, i) => i !== globalIndex));
        setHasEdited(true);
    }

    // 💡 데이터 준비 함수 (handleSave 대체)
    async function handleDataPrepare() {
        if (rows.length === 0 || !originalFile) {
            alert("처리할 데이터가 없습니다.");
            return;
        }
        setPreparing(true);

        try {
            // 🚨 경고: 이 방식은 대용량 파일에서 브라우저 메모리 부하를 일으킬 수 있습니다.
            // 모든 rawData를 상위 컴포넌트의 메모리로 전송합니다.

            const fileHeaders = Object.keys(rows[0] || {});

            onNewDataReady({
                sourceType: 'upload',
                rawData: rows, // 💡 메모리상의 모든 데이터 전달
                fileHeaders: fileHeaders,
                count: rows.length,
            });

            // 성공 후 상태 초기화 (옵션)
            setRows([]);
            setOriginalFile(null);
            setFileUploadedSuccess(false);

        } catch (e: any) {
            alert(e.message || "데이터 준비 실패");
        } finally {
            setPreparing(false);
        }
    }

    const fileHeaders = rows.length > 0 ? Object.keys(rows[0]) : [];

    return (
        <div className="space-y-8">
            {/* Upload Area */}
            <div className="rounded-2xl overflow-hidden border border-zinc-100 shadow-lg">
                <div className="bg-gradient-to-r from-blue-700 to-blue-900 px-8 py-6">
                    <div className="flex items-center gap-3">
                        <UploadCloud className="w-6 h-6 text-white" />
                        <h2 className="text-xl font-semibold text-white">파일 선택</h2>
                    </div>
                    <p className="text-blue-100 text-sm mt-2">
                        엑셀(.xlsx) 또는 CSV 파일을 선택하세요.
                    </p>
                </div>

                <div className="p-6 bg-white">
                    <input
                        className="block w-full cursor-pointer rounded-xl border-2 border-zinc-200 bg-white px-3 py-2 text-sm
                        file:mr-3 file:rounded-lg file:border-0 file:bg-blue-50 file:px-3 file:py-2 file:text-sm 
                        hover:file:bg-blue-100 focus:outline-none focus:border-blue-600 focus:ring-4 focus:ring-blue-100"
                        type="file"
                        accept=".xlsx,.csv"
                        onChange={(e) => {
                            const f = e.target.files?.[0];
                            if (f) handleFileUpload(f);
                        }}
                        disabled={uploading}
                    />

                    {uploading && (
                        <div className="flex items-center gap-2 mt-3 text-blue-700 text-sm">
                            <Loader2 className="w-4 h-4 animate-spin" />
                            파일을 처리 중입니다...
                        </div>
                    )}
                    {fileUploadedSuccess && !uploading && (
                        <div className="flex items-center gap-2 mt-3 text-emerald-700 text-sm font-medium">
                            <FileSpreadsheet className="w-4 h-4" />
                            {originalFile?.name} ({rows.length}개 레코드) 미리보기 준비 완료.
                        </div>
                    )}
                </div>
            </div>

            {/* Editable Table & Prepare Button */}
            {rows.length > 0 ? (
                <>
                    <div className="rounded-2xl overflow-hidden border border-zinc-100 shadow-lg">
                        <div className="bg-gradient-to-r from-blue-700 to-blue-900 px-8 py-6">
                            <h2 className="text-xl font-semibold text-white">데이터 미리보기 및 편집</h2>
                            <p className="text-blue-100 text-sm mt-2">{originalFile?.name} | 총 {rows.length}건</p>
                        </div>

                        <div className="p-6 bg-white overflow-x-auto">
                            <table className="w-full border-collapse text-sm">
                                <thead className="bg-blue-50 text-blue-800">
                                    <tr>
                                        <th className="px-3 py-2 text-left font-semibold w-[60px]">#</th>
                                        {fileHeaders.map((key) => (
                                            <th key={key} className="px-3 py-2 text-left font-semibold whitespace-nowrap">
                                                {key}
                                            </th>
                                        ))}
                                        <th className="px-3 py-2 text-center font-semibold w-[80px]">삭제</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {currentRows.map((row, i) => (
                                        <tr key={(currentPage - 1) * rowsPerPage + i} className="border-t border-zinc-200 hover:bg-blue-50 transition-colors">
                                            <td className="px-3 py-1 text-zinc-500 text-center">
                                                {(currentPage - 1) * rowsPerPage + i + 1}
                                            </td>
                                            {Object.entries(row).map(([key, value]) => (
                                                <td key={key} className="px-3 py-1">
                                                    <input
                                                        type="text"
                                                        value={value as string}
                                                        onChange={(e) => updateCell(i, key, e.target.value)}
                                                        className="w-full border border-transparent focus:border-blue-400 focus:ring-1 focus:ring-blue-200 rounded-md px-1 text-sm text-zinc-800"
                                                    />
                                                </td>
                                            ))}
                                            <td className="px-3 py-1 text-center">
                                                <button
                                                    onClick={() => handleDelete(i)}
                                                    className="text-red-600 hover:text-red-800"
                                                >
                                                    <Trash2 className="w-4 h-4 inline" />
                                                </button>
                                            </td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>

                            {/* 페이지네이션 */}
                            <div className="flex justify-between items-center mt-4 text-sm text-zinc-700">
                                <div>
                                    총 {rows.length}건 중 {(currentPage - 1) * rowsPerPage + 1}–
                                    {Math.min(currentPage * rowsPerPage, rows.length)} 표시
                                </div>
                                <div className="flex items-center gap-2">
                                    <button
                                        disabled={currentPage === 1}
                                        onClick={() => setCurrentPage((p) => Math.max(1, p - 1))}
                                        className="p-2 rounded-md border border-zinc-200 hover:bg-zinc-100 disabled:opacity-50"
                                    >
                                        <ChevronLeft className="w-4 h-4" />
                                    </button>
                                    <span>
                                        {currentPage} / {totalPages}
                                    </span>
                                    <button
                                        disabled={currentPage === totalPages}
                                        onClick={() => setCurrentPage((p) => Math.min(totalPages, p + 1))}
                                        className="p-2 rounded-md border border-zinc-200 hover:bg-zinc-100 disabled:opacity-50"
                                    >
                                        <ChevronRight className="w-4 h-4" />
                                    </button>
                                </div>
                            </div>
                        </div>

                        {/* Prepare Button */}
                        <div className="flex justify-between items-center p-6 bg-zinc-50 border-t">
                            <div className="text-sm text-zinc-600">
                                {hasEdited ? "⚠️ 변경 사항이 있습니다. 준비 시 반영됩니다." : "원본 데이터가 준비되었습니다."}
                            </div>
                            <button
                                onClick={handleDataPrepare} // 💡 수정된 함수 호출
                                disabled={preparing || rows.length === 0}
                                className="flex items-center gap-2 px-6 py-3 bg-blue-700 hover:bg-blue-800 text-white font-medium rounded-lg shadow-md disabled:opacity-50 transition-all"
                            >
                                {preparing ? (
                                    <>
                                        <Loader2 className="w-4 h-4 animate-spin" />
                                        데이터 준비 중...
                                    </>
                                ) : (
                                    <>
                                        <ArrowRight className="w-4 h-4" />
                                        업로드 완료 및 데이터 준비
                                    </>
                                )}
                            </button>
                        </div>
                    </div>
                </>
            ) : (
                // 파일이 업로드되지 않았을 때 취소 버튼 표시
                <div className="flex justify-end p-6">
                    <button onClick={onCancel} className="px-4 py-2 text-zinc-600 hover:text-zinc-800 disabled:opacity-50" disabled={uploading}>
                        취소
                    </button>
                </div>
            )}
        </div>
    );
}