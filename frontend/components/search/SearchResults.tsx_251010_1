import { SearchResp } from '@lib/types';

type Props = {
  resp: SearchResp | null;
  page: number;
  loading?: boolean;
  onChangePage: (nextPage: number) => void;
};

export default function SearchResults({ resp, page, loading, onChangePage }: Props) {
  if (!resp) return null;

  const maxPage = Math.max(1, Math.ceil(resp.total / resp.size));

  return (
    <div style={{ margin: '2rem auto', maxWidth: 980, textAlign: 'left' }}>
      <div style={{ color: '#666', marginBottom: 8 }}>검색 결과: {resp.total.toLocaleString()}건</div>
      {resp.data.map(row => {
        const h = resp.hits.find(x => x.key === row.official_number);
        return (
          <div key={row.official_number} style={{
            border: '1px solid #e5e7eb',
            borderRadius: 12,
            padding: '1rem 1.25rem',
            marginBottom: '0.75rem',
            background: '#fff',
            boxShadow: '0 1px 2px rgba(0,0,0,0.04)'
          }}>
            <div style={{ fontSize: '0.9rem', color: '#888' }}>{row.official_number}</div>
            <div style={{ fontSize: '1.1rem', fontWeight: 700, marginTop: 4 }}>
              {row.title || h?.title || '(제목 없음)'}&nbsp;
              <a style={{ marginTop: 8, fontSize: '0.9rem', color: '#666' }}>
              📅&nbsp;{row.filing_date && <>{row.filing_date}</>}
              </a>
            </div>
            
            <div style={{ fontSize: '0.95rem', color: '#555', marginTop: 6 }}>
              {h?.highlight?.title?.length ? (
                <div dangerouslySetInnerHTML={{ __html: h.highlight.title[0] }} />
              ) : h?.highlight?.abstract?.length ? (
                <div dangerouslySetInnerHTML={{ __html: h.highlight.abstract[0] }} />
              ) : (
                <span>{row.abstract ?? h?.abstract ?? ''}</span>
              )}
            </div>
            {/* <div style={{ marginTop: 8, fontSize: '0.9rem', color: '#666' }}>
              {row.abstract && <>💼 {row.abstract} &nbsp;</>}
              {row.filing_date && <>📅 {row.filing_date}</>}
            </div> */}
          </div>
        );
      })}

      <div style={{ display: 'flex', justifyContent: 'center', gap: 8, marginTop: 16 }}>
        <button
          onClick={() => onChangePage(Math.max(1, page - 1))}
          disabled={loading || page <= 1}
          style={{ padding: '0.5rem 0.9rem', borderRadius: 10, border: '1px solid #ddd', background: '#fafafa' }}
        >이전</button>
        <div style={{ padding: '0.5rem 0.75rem' }}>{page} / {maxPage}</div>
        <button
          onClick={() => onChangePage(Math.min(maxPage, page + 1))}
          disabled={loading || page >= maxPage}
          style={{ padding: '0.5rem 0.9rem', borderRadius: 10, border: '1px solid #ddd', background: '#fafafa' }}
        >다음</button>
      </div>
    </div>
  );
}
