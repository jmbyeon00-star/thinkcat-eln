"use client";
import {
  LineChart,
  Line,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  ResponsiveContainer,
  LabelList,
  Legend,
} from "recharts";

const lineData = [
  { epoch: 1, KoBERT: 0.0139, Private: 0.0154 },
  { epoch: 2, KoBERT: 0.0333, Private: 0.0750 },
  { epoch: 3, KoBERT: 0.0139, Private: 0.2200 },
  { epoch: 4, KoBERT: 0.0222, Private: 0.3473 },
  { epoch: 5, KoBERT: 0.0472, Private: 0.5541 },
  { epoch: 6, KoBERT: 0.0472, Private: 0.5780 },
  { epoch: 7, KoBERT: 0.0639, Private: 0.6464 },
  { epoch: 8, KoBERT: 0.1111, Private: 0.6464 },
  { epoch: 9, KoBERT: 0.1833, Private: 0.6464 },
  { epoch: 10, KoBERT: 0.2806, Private: 0.6464 },
  { epoch: 11, KoBERT: 0.3972, Private: 0.6464 },
  { epoch: 12, KoBERT: 0.4722, Private: 0.6464 },
  { epoch: 13, KoBERT: 0.5028, Private: 0.6464 },
  { epoch: 14, KoBERT: 0.5111, Private: 0.6464 },
  { epoch: 15, KoBERT: 0.5167, Private: 0.6464 },
  { epoch: 16, KoBERT: 0.5056, Private: 0.6464 },
  { epoch: 17, KoBERT: 0.5500, Private: 0.6464 },
  { epoch: 18, KoBERT: 0.5444, Private: 0.6464 },
  { epoch: 19, KoBERT: 0.5444, Private: 0.6464 },
  { epoch: 20, KoBERT: 0.5611, Private: 0.6464 }

];

const CustomTooltip = ({ active, payload, label }) => {
  if (active && payload && payload.length) {
    return (
      <div className="bg-white px-4 py-3 rounded-lg shadow-lg border border-zinc-200">
        <p className="text-sm font-semibold text-zinc-700 mb-2">Epoch {label}</p>
        {payload.map((entry, index) => (
          <div key={index} className="flex items-center gap-2 text-sm">
            <div 
              className="w-3 h-3 rounded-full" 
              style={{ backgroundColor: entry.color }}
            />
            <span className="text-zinc-600">{entry.name}:</span>
            <span className="font-semibold text-zinc-900">{entry.value.toFixed(4)}</span>
          </div>
        ))}
      </div>
    );
  }
  return null;
};

export default function ModelAccuracyLineChart() {
  return (
    <div className="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-50 p-8">
      <div className="max-w-5xl mx-auto">
        {/* Header */}
        <div className="mb-8">
          <h1 className="text-3xl font-bold text-zinc-900 mb-2">
            모델 학습 성능 분석
          </h1>
          <p className="text-zinc-600">
            KoBERT와 Private 모델의 Epoch별 정확도 비교
          </p>
        </div>

        {/* Chart Card */}
        <div className="bg-white rounded-2xl shadow-xl border border-zinc-100 overflow-hidden">
          {/* Card Header */}
          <div className="bg-gradient-to-r from-blue-600 to-indigo-600 px-8 py-6">
            <h2 className="text-xl font-semibold text-white mb-2">
              모델별 학습 추이
            </h2>
            <p className="text-blue-100 text-sm">
              Training Accuracy over Epochs
            </p>
          </div>

          {/* Stats Summary */}
          <div className="grid grid-cols-2 gap-6 px-8 py-6 bg-zinc-50 border-b border-zinc-100">
            <div className="bg-white rounded-xl p-4 shadow-sm border border-red-100">
              <div className="flex items-center gap-2 mb-2">
                <div className="w-3 h-3 bg-red-500 rounded-full" />
                <span className="text-sm font-medium text-zinc-700">KoBERT</span>
              </div>
              <div className="text-2xl font-bold text-zinc-900">
                {lineData[lineData.length - 1].KoBERT.toFixed(4)}
              </div>
              <div className="text-xs text-zinc-500 mt-1">최종 정확도</div>
            </div>
            
            <div className="bg-white rounded-xl p-4 shadow-sm border border-cyan-100">
              <div className="flex items-center gap-2 mb-2">
                <div className="w-3 h-3 bg-cyan-500 rounded-full" />
                <span className="text-sm font-medium text-zinc-700">Private</span>
              </div>
              <div className="text-2xl font-bold text-zinc-900">
                {lineData[lineData.length - 1].Private.toFixed(4)}
              </div>
              <div className="text-xs text-zinc-500 mt-1">최종 정확도</div>
            </div>
          </div>

          {/* Chart */}
          <div className="p-8">
            <div className="w-full h-96">
              <ResponsiveContainer width="100%" height="100%">
                <LineChart 
                  data={lineData} 
                  margin={{ top: 30, right: 30, left: 10, bottom: 20 }}
                >
                  <defs>
                    <linearGradient id="colorKoBERT" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="5%" stopColor="#ef4444" stopOpacity={0.1}/>
                      <stop offset="95%" stopColor="#ef4444" stopOpacity={0}/>
                    </linearGradient>
                    <linearGradient id="colorPrivate" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="5%" stopColor="#06b6d4" stopOpacity={0.1}/>
                      <stop offset="95%" stopColor="#06b6d4" stopOpacity={0}/>
                    </linearGradient>
                  </defs>
                  
                  <CartesianGrid strokeDasharray="3 3" stroke="#e4e4e7" />
                  
                  <XAxis 
                    dataKey="epoch"
                    tick={{ fill: '#52525b', fontSize: 12 }}
                    label={{ 
                      value: "Epoch", 
                      position: "insideBottom", 
                      offset: -10,
                      style: { fill: '#3f3f46', fontWeight: 600 }
                    }}
                  />
                  
                  <YAxis 
                    domain={[0, 0.7]}
                    tick={{ fill: '#52525b', fontSize: 12 }}
                    label={{ 
                      value: "Accuracy", 
                      angle: -90, 
                      position: "insideLeft",
                      style: { fill: '#3f3f46', fontWeight: 600 }
                    }}
                  />
                  
                  <Tooltip content={<CustomTooltip />} />
                  
                  <Legend 
                    wrapperStyle={{ paddingTop: '20px' }}
                    iconType="line"
                  />
                  
                  <Line
                    type="monotone"
                    dataKey="KoBERT"
                    stroke="#ef4444"
                    strokeWidth={3}
                    dot={{ 
                      fill: '#ef4444', 
                      stroke: '#fff',
                      strokeWidth: 2,
                      r: 6
                    }}
                    activeDot={{ r: 8 }}
                  >
                    <LabelList
                      dataKey="KoBERT"
                      position="top"
                      offset={12}
                      style={{ 
                        fontSize: '11px', 
                        fontWeight: 600,
                        fill: '#991b1b'
                      }}
                      formatter={(value) =>
                        typeof value === "number" ? value.toFixed(4) : String(value)
                      }
                    />
                  </Line>
                  
                  <Line
                    type="monotone"
                    dataKey="Private"
                    stroke="#06b6d4"
                    strokeWidth={3}
                    dot={{ 
                      fill: '#06b6d4',
                      stroke: '#fff',
                      strokeWidth: 2,
                      r: 6
                    }}
                    activeDot={{ r: 8 }}
                  >
                    <LabelList
                      dataKey="Private"
                      position="bottom"
                      offset={12}
                      style={{ 
                        fontSize: '11px', 
                        fontWeight: 600,
                        fill: '#0e7490'
                      }}
                      formatter={(value) =>
                        typeof value === "number" ? value.toFixed(4) : String(value)
                      }
                    />
                  </Line>
                </LineChart>
              </ResponsiveContainer>
            </div>
          </div>

          {/* Footer Note */}
          <div className="px-8 py-4 bg-zinc-50 border-t border-zinc-100">
            <p className="text-xs text-zinc-500">
              💡 Private 모델이 Epoch 6에서 최고 정확도를 달성했습니다.
            </p>
          </div>
        </div>
      </div>
    </div>
  );
}