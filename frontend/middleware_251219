// frontend/middleware.ts
import { NextResponse } from "next/server";
import type { NextRequest } from "next/server";
import { withAuth } from "next-auth/middleware";

const SUPPORTED_LOCALES = ["en", "ko"];
const DEFAULT_LOCALE = "en";

/* =========================
   1️⃣ Locale middleware
========================= */
function localeMiddleware(req: NextRequest) {
  const { pathname } = req.nextUrl;

  // 완전 제외
  if (
    pathname.startsWith("/_next") ||
    pathname.startsWith("/api") ||
    pathname.startsWith("/auth") ||
    pathname.includes(".")
  ) {
    return NextResponse.next();
  }

  const hasLocale = SUPPORTED_LOCALES.some(
    (l) => pathname === `/${l}` || pathname.startsWith(`/${l}/`)
  );

  if (!hasLocale && pathname !== "/") {
    const cookieLocale = req.cookies.get("locale")?.value;

    const locale =
      cookieLocale && SUPPORTED_LOCALES.includes(cookieLocale)
        ? cookieLocale
        : req.headers.get("accept-language")?.startsWith("ko")
          ? "ko"
          : DEFAULT_LOCALE;

    return NextResponse.redirect(
      new URL(`/${locale}${pathname}`, req.url)
    );
  }

  return NextResponse.next();
}

/* =========================
   2️⃣ Auth middleware
========================= */
const authMiddleware = withAuth(
  function () {
    return NextResponse.next();
  },
  {
    callbacks: {
      authorized: ({ token, req }) => {
        const pathname = req.nextUrl.pathname;

        // auth 페이지는 항상 허용
        if (pathname.startsWith("/auth")) {
          return true;
        }

        return !!token;
      },
    },
    pages: {
      signIn: "/auth/signin", // locale은 아래에서 처리
    },
  }
);

/* =========================
   3️⃣ Compose
========================= */
export default function middleware(req: NextRequest) {
  // 1. locale 먼저
  const localeResult = localeMiddleware(req);
  if (localeResult.headers.get("location")) {
    return localeResult;
  }

  // 2. auth는 locale 확정 후
  return authMiddleware(req);
}

export const config = {
  matcher: [
    "/((?!_next|api|favicon.ico|.*\\..*).*)",
  ],
};
