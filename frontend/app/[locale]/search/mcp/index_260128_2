import React, { useState, useCallback } from 'react';
import { useRouter } from 'next/router';
import { useSession } from "next-auth/react";
import { Session } from "next-auth"
import Head from 'next/head';
import { SearchOptions, SearchResultItem } from '@/types/search';
import { ArrowUp, Search, Hash, XCircle, ChevronRight, Sparkles, Filter, Database, MessageSquare } from 'lucide-react';

import { useTranslations } from 'next-intl';
import { withMessages } from '@/lib/i18n/withMessages';

export const getServerSideProps = withMessages();

const inputClassName = "w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 transition-all font-semibold text-slate-700 placeholder:text-slate-300 text-sm";

export default function SearchPage() {
    const router = useRouter();
    const translator = useTranslations();
    const API_BASE = process.env.NEXT_PUBLIC_API_BASE_URL;

    const { data: session } = useSession() as {
        data: (Session & { access_token?: string }) | null;
        status: "loading" | "authenticated" | "unauthenticated";
    };
    const token = session?.access_token;

    // --- [상태 관리] ---
    const [hasSearched, setHasSearched] = useState(false);
    const [searchTab, setSearchTab] = useState<'ai' | 'standard'>('ai'); // AI vs 일반 탭
    const [isLoading, setIsLoading] = useState(false);
    const [query, setQuery] = useState(''); // AI 채팅/검색어
    const [results, setResults] = useState<SearchResultItem[]>([]);
    const [error, setError] = useState<string | null>(null);

    // AI 분석 결과이자 일반 검색의 키워드가 될 상태
    const [targetKeyword, setTargetKeyword] = useState('');

    const [options, setOptions] = useState<SearchOptions>({
        search_type: null,
        use_vector: true,
        filters: { filing_year: { gte: undefined, lte: undefined }, applicant_name: '', inventor_name: '' },
        exact_match: { application_number: '' },
        text_query: { fields: [], keyword: [] },
    });

    // --- [검색 로직] ---

    // 1. AI 의도 분석 검색 (하단/중앙 검색바 전용)
    const handleAISearch = async (e: React.FormEvent) => {
        e.preventDefault();
        if (!query.trim()) return;

        setIsLoading(true);
        setError(null);
        setHasSearched(true);

        try {
            const response = await fetch(`${API_BASE}/api/search/mcp`, {
                method: "POST",
                headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
                body: JSON.stringify({ query, options }),
            });
            const data = await response.json();

            // 🎯 AI가 뽑은 키워드를 일반 검색창에 채워줌
            const aiKeywords = data.intent.text_query?.keywords?.join(' ') || data.intent.text_query?.text_query || '';
            setTargetKeyword(aiKeywords);

            setResults(data.results.data.results.hits.hits || []);

            // 🎯 유저가 입력하지 않은 필터만 AI 분석값으로 자동 채우기
            setOptions(prev => ({
                ...prev,
                filters: {
                    applicant_name: prev.filters.applicant_name || data.intent.filters?.applicant_name || '',
                    inventor_name: prev.filters.inventor_name || data.intent.filters?.inventor_name || '',
                    filing_year: {
                        gte: prev.filters.filing_year?.gte || data.intent.filters?.filing_year?.gte,
                        lte: prev.filters.filing_year?.lte || data.intent.filters?.filing_year?.lte,
                    }
                },
                exact_match: {
                    application_number: prev.exact_match?.application_number || data.intent.exact_match?.application_number || ''
                }
            }));
        } catch (err) {
            setError('AI 검색 중 오류가 발생했습니다.');
        } finally { setIsLoading(false); }
    };

    // 2. 일반 검색 (상단 필터 및 키워드 수정 후 실행)
    // const handleStandardSearch = async () => {
    //     setIsLoading(true);
    //     setHasSearched(true);

    //     try {
    //         const response = await fetch(`${API_BASE}/api/search/mcp`, {
    //             method: "POST",
    //             headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
    //             body: JSON.stringify({
    //                 query: targetKeyword, // 수정된 키워드를 메인 쿼리로 사용
    //                 options: {
    //                     ...options,
    //                     text_query: { ...options.text_query, text_query: targetKeyword }
    //                 }
    //             }),
    //         });
    //         const data = await response.json();
    //         setResults(data.results.data.results.hits.hits || []);
    //     } catch (err) {
    //         setError('일반 검색 결과 갱신에 실패했습니다.');
    //     } finally { setIsLoading(false); }
    // };
    const handleStandardSearch = useCallback(async (e?: React.SyntheticEvent) => {
        if (e) e.preventDefault();

        console.log("targetKeyword:", targetKeyword)

        // 🎯 우선순위: 우측 키워드 수정창(targetKeyword) > 하단 메인 검색창(query)
        // 둘 중 하나라도 값이 있으면 검색을 진행합니다.
        const currentKeyword = targetKeyword.trim() || query.trim();

        if (!currentKeyword) {
            setError('검색어를 입력해주세요.');
            return;
        }

        setIsLoading(true);
        setError(null);

        try {
            const response = await fetch(`${API_BASE}/api/search/standard`, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    Authorization: `Bearer ${token}`
                },
                // 백엔드의 'options.text_query.text_query' 경로와 일치시킵니다.
                body: JSON.stringify({
                    query: currentKeyword,
                    options: {
                        ...options,
                        text_query: {
                            ...options.text_query,
                            text_query: currentKeyword
                        }
                    }
                }),
            });

            const data = await response.json();
            setResults(data.results.data.results.hits.hits || []);
            setHasSearched(true);

            // 🎯 검색 성공 후, 현재 검색된 키워드를 수정창에도 동기화 (UX 통일성)
            setTargetKeyword(currentKeyword);

        } catch (err) {
            setError('검색 실패: 서버 연결 상태를 확인해주세요.');
        } finally {
            setIsLoading(false);
        }
    }, [query, targetKeyword, options, API_BASE, token]);

    return (
        <div className="min-h-screen bg-white font-sans selection:bg-indigo-100 selection:text-indigo-900">
            <Head><title>Patent Intelligence | Search</title></Head>

            {/* 🎯 메인 레이아웃 전환 */}
            <main className={`flex flex-col transition-all duration-700 ${!hasSearched ? 'h-[85vh] items-center justify-center' : 'pt-10 pb-40'}`}>

                {/* [Zero State] 초기 로고 및 안내 */}
                {!hasSearched && (
                    <div className="text-center mb-10 animate-in fade-in zoom-in duration-1000">
                        <h1 className="text-5xl font-black text-slate-900 tracking-tighter mb-4">어떤 특허를 찾으시나요?</h1>
                        <p className="text-slate-500 text-lg font-medium">인공지능이 당신의 검색 의도를 완벽하게 이해합니다.</p>
                    </div>
                )}

                {/* [Result State] 검색 후 나타나는 필터 및 키워드 관리자 */}
                {hasSearched && (
                    <div className="max-w-6xl w-full mx-auto px-6 space-y-6 animate-in fade-in slide-in-from-bottom-4 duration-700">
                        <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">

                            {/* 수동 필터 설정 영역 */}
                            <div className="lg:col-span-7 bg-white p-6 rounded-[2.5rem] border border-slate-100 shadow-sm space-y-4">
                                <h3 className="flex items-center gap-2 text-[11px] font-black text-slate-400 uppercase tracking-widest px-2">
                                    <Filter size={14} /> 상세 필터 설정
                                </h3>
                                <div className="grid grid-cols-2 gap-4">
                                    <div className="space-y-1">
                                        <label className="text-[10px] font-black text-slate-400 ml-2 uppercase">출원 연도</label>
                                        <div className="flex gap-2">
                                            <input type="number" placeholder="From" className={inputClassName} value={options.filters.filing_year?.gte ?? ""} onChange={(e) => setOptions(prev => ({ ...prev, filters: { ...prev.filters, filing_year: { ...prev.filters.filing_year, gte: e.target.value ? Number(e.target.value) : undefined } } }))} />
                                            <input type="number" placeholder="To" className={inputClassName} value={options.filters.filing_year?.lte ?? ""} onChange={(e) => setOptions(prev => ({ ...prev, filters: { ...prev.filters, filing_year: { ...prev.filters.filing_year, lte: e.target.value ? Number(e.target.value) : undefined } } }))} />
                                        </div>
                                    </div>
                                    <div className="space-y-1">
                                        <label className="text-[10px] font-black text-slate-400 ml-2 uppercase">출원번호</label>
                                        <input type="text" placeholder="번호 입력" className={inputClassName} value={options.exact_match?.application_number ?? ""} onChange={(e) => setOptions(prev => ({ ...prev, exact_match: { ...prev.exact_match, application_number: e.target.value } }))} />
                                    </div>
                                    <div className="space-y-1">
                                        <label className="text-[10px] font-black text-slate-400 ml-2 uppercase">출원인</label>
                                        <input type="text" placeholder="회사명/성명" className={inputClassName} value={options.filters.applicant_name ?? ""} onChange={(e) => setOptions(prev => ({ ...prev, filters: { ...prev.filters, applicant_name: e.target.value } }))} />
                                    </div>
                                    <div className="space-y-1">
                                        <label className="text-[10px] font-black text-slate-400 ml-2 uppercase">발명인</label>
                                        <input type="text" placeholder="발명자 성명" className={inputClassName} value={options.filters.inventor_name ?? ""} onChange={(e) => setOptions(prev => ({ ...prev, filters: { ...prev.filters, inventor_name: e.target.value } }))} />
                                    </div>
                                </div>
                            </div>

                            {/* 키워드 수정 및 일반 검색 실행 */}
                            <div className="lg:col-span-5">
                                <section className="bg-zinc-50/50 p-6 rounded-[2.5rem] border border-zinc-100 shadow-sm flex flex-col h-full">
                                    <h3 className="flex items-center gap-2 text-[11px] font-black text-zinc-600 uppercase tracking-widest mb-4">
                                        <Database size={14} /> 키워드 최적화
                                    </h3>
                                    <textarea
                                        value={targetKeyword}
                                        onChange={(e) => setTargetKeyword(e.target.value)}
                                        className="flex-1 w-full bg-white border border-zinc-100 rounded-2xl p-4 text-sm font-bold text-slate-700 outline-none focus:ring-2 focus:ring-zinc-200 transition-all resize-none min-h-[120px]"
                                        placeholder="검색 키워드를 입력하거나 AI 분석 결과를 수정하세요..."
                                    />
                                    <button
                                        onClick={handleStandardSearch}
                                        className="mt-4 w-full bg-zinc-600 text-white py-3 rounded-xl font-black text-xs uppercase flex items-center justify-center gap-2 hover:bg-zinc-700 transition-all active:scale-[0.98]"
                                    >
                                        <Search size={14} /> 키워드 검색
                                    </button>
                                </section>
                            </div>

                        </div>

                        {/* 결과 테이블 */}
                        <section className="space-y-4">
                            <div className="flex items-center justify-between px-2">
                                <h2 className="text-xl font-black text-slate-900">검색 결과 <span className="text-indigo-600">{results.length}</span></h2>
                            </div>
                            <div className="grid gap-3">
                                {results.map((item, idx) => (
                                    <div key={idx} className="group p-5 bg-white border border-slate-100 rounded-3xl hover:shadow-md transition-all cursor-pointer flex justify-between items-center" onClick={() => router.push(`/search/detail/application/${item._source.application_number}`)}>
                                        <div>
                                            <p className="text-[10px] font-bold text-slate-400 mb-1">{item._source.application_number} | {item._source.applicant_name}</p>
                                            <h4 className="font-bold text-slate-800 group-hover:text-indigo-600 transition-colors">{item._source.title}</h4>
                                        </div>
                                        <ChevronRight size={18} className="text-slate-300" />
                                    </div>
                                ))}
                            </div>
                        </section>
                    </div>
                )}
            </main>

            {/* 🎯 [하단 고정] 탭 + 검색바 섹션 */}
            {/* <div className={`fixed bottom-10 left-1/2 -translate-x-1/2 w-full max-w-3xl px-6 z-50 transition-all duration-700`}>

                <div className="flex gap-2 mb-3 ml-4">
                    <button
                        onClick={() => setSearchTab('ai')}
                        className={`flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-black uppercase tracking-tighter transition-all ${searchTab === 'ai' ? 'bg-indigo-600 text-white shadow-lg shadow-indigo-100' : 'bg-slate-100 text-slate-400 hover:bg-slate-200'}`}
                    >
                        <Sparkles size={12} /> AI 검색
                    </button>
                    <button
                        onClick={() => setSearchTab('standard')}
                        className={`flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-black uppercase tracking-tighter transition-all ${searchTab === 'standard' ? 'bg-slate-800 text-white shadow-lg' : 'bg-slate-100 text-slate-400 hover:bg-slate-200'}`}
                    >
                        <Database size={12} /> 일반 검색
                    </button>
                </div>

                <form
                    onSubmit={searchTab === 'ai' ? handleAISearch : (e) => { e.preventDefault(); handleStandardSearch(); }}
                    className="bg-[#f0f4f9] rounded-[32px] p-2 pl-6 shadow-sm border border-transparent focus-within:bg-white focus-within:shadow-2xl focus-within:border-slate-200 transition-all duration-300 flex items-center gap-2"
                >
                    <div className="flex flex-col flex-1 py-2">
                        <input
                            type="text"
                            value={query}
                            onChange={(e) => setQuery(e.target.value)}
                            placeholder={searchTab === 'ai' ? "특허 의도를 입력하세요 (예: 2020년 이후 삼성전자의 자율주행 특허)" : "일반 키워드 또는 필터 조건을 입력하세요"}
                            className="bg-transparent border-none outline-none text-slate-800 text-[17px] font-medium placeholder:text-slate-500 w-full"
                        />
                    </div>

                    <button
                        type="submit"
                        disabled={isLoading || !query.trim()}
                        className={`w-12 h-12 flex items-center justify-center rounded-full transition-all 
                            ${query.trim() && !isLoading ? (searchTab === 'ai' ? 'bg-indigo-600' : 'bg-slate-800') + ' text-white shadow-md' : 'text-slate-400 bg-transparent'}`}
                    >
                        {isLoading ? <span className="animate-spin text-lg">✦</span> : <ArrowUp size={22} strokeWidth={2.5} />}
                    </button>
                </form>
            </div> */}

            <div className="fixed bottom-10 left-1/2 -translate-x-1/2 w-full max-w-4xl px-6 z-50 transition-all duration-700">
                {/* 메인 컨테이너: 내부로 탭을 흡수 */}
                <div className="bg-[#f0f4f9] rounded-[32px] p-4 shadow-sm border border-transparent focus-within:bg-white focus-within:shadow-2xl focus-within:border-slate-200 transition-all duration-300 flex flex-col gap-2">

                    {/* 탭 스위처: 입력창 내부 상단에 배치 */}
                    <div className="flex gap-2 ml-2 mb-1">
                        <button
                            onClick={() => setSearchTab('ai')}
                            className={`flex items-center gap-2 px-4 py-1.5 rounded-full text-[11px] font-black uppercase tracking-tighter transition-all ${searchTab === 'ai'
                                ? 'bg-indigo-600 text-white shadow-md'
                                : 'text-slate-500 hover:bg-slate-200/50'
                                }`}
                        >
                            <Sparkles size={12} /> AI 검색
                        </button>
                        <button
                            onClick={() => setSearchTab('standard')}
                            className={`flex items-center gap-2 px-4 py-1.5 rounded-full text-[11px] font-black uppercase tracking-tighter transition-all ${searchTab === 'standard'
                                ? 'bg-slate-800 text-white shadow-md'
                                : 'text-slate-500 hover:bg-slate-200/50'
                                }`}
                        >
                            <Database size={12} /> 일반 검색
                        </button>
                    </div>

                    {/* 입력 영역: textarea로 변경하여 높이 확보 및 줄바꿈 허용 */}
                    <div className="flex items-end gap-2 pl-2">
                        <textarea
                            rows={2} // 기본 높이 설정
                            value={query}
                            onChange={(e) => setQuery(e.target.value)}
                            placeholder={
                                searchTab === 'ai'
                                    ? "특허 의도를 입력하세요 (예: 2020년 이후 삼성전자의 자율주행 특허)"
                                    : "일반 키워드 또는 필터 조건을 입력하세요"
                            }
                            className="bg-transparent border-none outline-none text-slate-800 text-[17px] font-medium placeholder:text-slate-400 w-full resize-none py-2 max-h-60"
                        />

                        {/* 전송 버튼: 이제 onClick으로만 작동 */}
                        <button
                            onClick={searchTab === 'ai' ? handleAISearch : handleStandardSearch}
                            disabled={isLoading || !query.trim()}
                            className={`flex-shrink-0 w-12 h-12 flex items-center justify-center rounded-full transition-all 
                                ${query.trim() && !isLoading
                                    ? (searchTab === 'ai' ? 'bg-indigo-600' : 'bg-slate-800') + ' text-white shadow-lg'
                                    : 'text-slate-300 bg-transparent cursor-not-allowed'}`}
                        >
                            {isLoading ? (
                                <span className="animate-spin text-lg">✦</span>
                            ) : (
                                <ArrowUp size={24} strokeWidth={2.5} />
                            )}
                        </button>
                    </div>
                </div>
            </div>

        </div>
    );
}