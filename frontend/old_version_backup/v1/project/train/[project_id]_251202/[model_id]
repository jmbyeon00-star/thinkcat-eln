import { useRouter } from "next/router";
import { useEffect, useState, useMemo } from "react";
import {
    Tooltip,
    ResponsiveContainer,
    LineChart,
    Line,
    CartesianGrid,
    XAxis,
    YAxis,
    Legend,
} from "recharts";
import {
    ArrowLeft,
    ChevronUp,
    ChevronDown,
    ChevronLeft,
    ChevronRight,
    FileBarChart2,
    Upload,
    Clock,
    Database,
    Layers,
    Activity,
    Loader2 // ✅ 수정: 누락된 Loader2 아이콘 추가
} from "lucide-react";
import Link from "next/link";
import { useSession } from "next-auth/react";
import { Session } from "next-auth";

// 기존 컴포넌트 import (경로는 프로젝트 구조에 맞게 조정 필요)
import ProjectLayout from "@/components/layouts/ProjectLayout";
import FilePreviewEditor from "@/components/FilePreviewEditor";
import ModelProgressSSE from "@/components/ModelProgressSSE";
import { useUserTaskStore } from '@/lib/store/useUserTaskStore';

// 유틸리티 함수 import
import { formatElapsed } from "@/utils/formatElapsed";
import { getSegmentColor } from "@/utils/randomSeed";
import { getEpochInfo, getBestAccuracyInfo } from "@/utils/calculate";
import { HistorySegment } from "@/types/ai";
import ModelRetrainSection from "@/components/project/ModelRetrainSection";

// --- Types ---
type ModelDetail = {
    id: number;
    model_name: string;
    model_desc?: string;
    data_scope: string;
    task_type: string;
    source_type: string;
    collection_num: number;
    progress: number;
    progress_status: "RUNNING" | "COMPLETED" | "FAILED";
    created_datetime?: string;
    train_status: number;
    elapsed_time: number;

    epoch?: number;
    batch_size?: number;
    learning_rate?: number;
    data_num?: number;
    n_data_num?: number;
    max_length?: number;

    history?: {
        segments: HistorySegment[];
    };
    mapping?: Record<string, string>;
};

type LineRow = {
    epoch: number;
    train_acc: number;
    valid_acc: number;
    train_loss: number;
    valid_loss: number;
    segment: number;
    color: string;
};

export default function ProjectModelDetailPage() {
    const router = useRouter();
    const { project_id, model_id } = router.query;

    // Store
    const { isBusy, progress: storeProgress, status: storeStatus, setState } = useUserTaskStore();
    const API_BASE = process.env.NEXT_PUBLIC_API_BASE_URL;

    // Session
    const { data: session } = useSession() as {
        data: (Session & { access_token?: string }) | null;
    };
    const token = session?.access_token;

    // State
    const [model, setModel] = useState<ModelDetail | null>(null);
    const [loading, setLoading] = useState(true);

    // Toggle Sections
    const [showBasicInfo, setShowBasicInfo] = useState(true);
    const [showAccuracy, setShowAccuracy] = useState(true);
    const [showLoss, setShowLoss] = useState(false);
    const [showCollectionList, setShowCollectionList] = useState(false);

    // Pagination for Mapping
    const [mappingPage, setMappingPage] = useState(1);
    const ITEMS_PER_PAGE = 10;

    // File Inference State
    const [parsedData, setParsedData] = useState<any[]>([]);
    const [inferLoading, setInferLoading] = useState(false);

    // --- Helpers ---
    const safeDecode = (text: any) => {
        try {
            if (typeof text === "string") return decodeURIComponent(escape(text));
            return text;
        } catch {
            return text;
        }
    };

    const { prevEpoch, added } = getEpochInfo(model?.history?.segments ?? []);
    const { prevBestAccuracy, recentBestAccuracy } = getBestAccuracyInfo(model?.history?.segments ?? []);

    // --- Data Fetching ---
    useEffect(() => {
        if (!model_id || !token) return;
        // 재학습 중이 아닐 때만 로드
        if (storeProgress !== -1 && storeProgress !== 0) return;

        setLoading(true);
        (async () => {
            try {
                // 모델 상세 정보 API 호출
                const res = await fetch(`${API_BASE}/api/ai/${model_id}`, {
                    headers: { Authorization: `Bearer ${token}` },
                    credentials: "include",
                });

                const buffer = await res.arrayBuffer();
                const text = new TextDecoder("utf-8").decode(buffer);
                const json = JSON.parse(text);

                // 디코딩 및 상태 설정
                const decoded = Object.fromEntries(
                    Object.entries(json).map(([k, v]) => [k, safeDecode(v)])
                );
                setModel(decoded as ModelDetail);
            } catch (err) {
                console.error("모델 불러오기 실패:", err);
            } finally {
                setLoading(false);
            }
        })();
    }, [model_id, token, isBusy, API_BASE]);

    // --- Chart Data Preparation ---
    const usedColors = new Set<string>();
    const lineData = useMemo(() => {
        if (!model?.history?.segments) return [];
        usedColors.clear();
        const rows: LineRow[] = [];
        let epochCounter = 1;
        const lastIndex = model.history.segments.length - 1;

        model.history.segments.forEach((seg, segIndex) => {
            const color = getSegmentColor(usedColors, segIndex, lastIndex);
            for (let i = 0; i < seg.train_acc.length; i++) {
                rows.push({
                    epoch: epochCounter++,
                    train_acc: seg.train_acc[i],
                    valid_acc: seg.valid_acc[i],
                    train_loss: seg.train_loss[i],
                    valid_loss: seg.valid_loss[i],
                    segment: segIndex,
                    color,
                });
            }
        });
        return rows;
    }, [model]);

    // --- Mapping Pagination ---
    const mappingEntries = useMemo(() => {
        if (!model?.mapping) return [];
        return Object.entries(model.mapping);
    }, [model?.mapping]);

    const totalMappingPages = Math.ceil(mappingEntries.length / ITEMS_PER_PAGE);
    const paginatedMapping = useMemo(() => {
        const start = (mappingPage - 1) * ITEMS_PER_PAGE;
        return mappingEntries.slice(start, start + ITEMS_PER_PAGE);
    }, [mappingEntries, mappingPage]);

    // --- Inference Handler ---
    const handleInferFile = async () => {
        if (!model_id || parsedData.length === 0) {
            alert("먼저 파일을 업로드해주세요.");
            return;
        }

        const firstRow = parsedData[0];
        const columns = Object.keys(firstRow || {}).map((c) => c.trim().toLowerCase());

        // 간단한 유효성 검사 (기존 로직 유지)
        if (columns.length === 0) {
            alert("파일에 컬럼이 없습니다.");
            return;
        }

        setInferLoading(true);
        try {
            setState({ isBusy: true, status: 'RUNNING', progress: 0 });

            const res = await fetch(
                `${API_BASE}/api/ai/infer/classification/${model?.data_scope}/${model_id}`,
                {
                    method: "POST",
                    headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
                    credentials: "include",
                    body: JSON.stringify({
                        data: parsedData,
                        collection_num: model?.collection_num,
                        source_type: model?.source_type,
                        task_type: model?.task_type,
                    }),
                }
            );

            // 결과 처리 로직 (필요시 상세 구현)
            const resultData = await res.json();
            console.log("Inference Result:", resultData);
            alert("추론이 완료되었습니다. (결과 페이지 연결 필요)");

        } catch (err) {
            console.error(err);
            alert("추론 중 오류가 발생했습니다.");
        } finally {
            setInferLoading(false);
            setState({ isBusy: false, status: 'AVAILABLE' });
        }
    };

    // --- Render ---
    if (loading) {
        return (
            <ProjectLayout step={5} sourceType={model?.source_type} projectNo={Number(project_id)}>
                <div className="min-h-[70vh] flex items-center justify-center">
                    <div className="flex flex-col items-center gap-3">
                        <Loader2 className="h-8 w-8 animate-spin text-blue-600" />
                        <span className="text-zinc-500 font-medium">모델 정보를 불러오는 중...</span>
                    </div>
                </div>
            </ProjectLayout>
        );
    }

    if (!model) {
        return (
            <ProjectLayout step={5} projectNo={Number(project_id)}>
                <div className="p-8 text-center">
                    <p className="text-red-500 font-bold">모델 정보를 찾을 수 없습니다.</p>
                    <Link href={`/project/train/${project_id}`} className="text-blue-600 hover:underline mt-4 block">
                        목록으로 돌아가기
                    </Link>
                </div>
            </ProjectLayout>
        );
    }

    return (
        <ProjectLayout step={5} sourceType={model.source_type} projectNo={Number(project_id)}>
            <div className="min-h-screen bg-zinc-50 p-8">
                <div className="max-w-6xl mx-auto space-y-6">

                    {/* Top Navigation & Status */}
                    <div className="flex items-center justify-between mb-2">
                        <Link
                            href={`/project/train/${project_id}`}
                            className="inline-flex items-center gap-1 text-sm text-zinc-500 hover:text-blue-600 font-medium transition-colors"
                        >
                            <ArrowLeft className="h-4 w-4" />
                            모델 목록으로 돌아가기
                        </Link>

                        <div className={`px-4 py-1.5 rounded-full text-sm font-bold shadow-sm flex items-center gap-2 ${model.progress_status === "COMPLETED" ? "bg-white text-green-600 border border-green-100" :
                            model.progress_status === "FAILED" ? "bg-white text-red-600 border border-red-100" :
                                "bg-white text-blue-600 border border-blue-100"
                            }`}>
                            <div className={`w-2 h-2 rounded-full ${model.progress_status === "COMPLETED" ? "bg-green-500" :
                                model.progress_status === "FAILED" ? "bg-red-500" :
                                    "bg-blue-500 animate-pulse"
                                }`} />
                            {model.progress_status === "COMPLETED" ? "학습 완료" :
                                model.progress_status === "FAILED" ? "학습 실패" :
                                    `학습 중 (${model.progress}%)`}
                        </div>
                    </div>

                    {/* Header Section */}
                    <div className="bg-white rounded-2xl p-8 border border-zinc-100 shadow-sm">
                        <h1 className="text-3xl font-bold text-zinc-900 mb-2">{safeDecode(model.model_name)}</h1>
                        <p className="text-zinc-600 text-lg">{safeDecode(model.model_desc) || "설명 없음"}</p>
                        <div className="flex gap-4 mt-6 text-sm text-zinc-500">
                            <div className="flex items-center gap-1.5 bg-zinc-50 px-3 py-1.5 rounded-lg">
                                <Clock className="w-4 h-4" />
                                <span>{model.created_datetime ? new Date(model.created_datetime).toLocaleString() : "-"}</span>
                            </div>
                            <div className="flex items-center gap-1.5 bg-zinc-50 px-3 py-1.5 rounded-lg">
                                <Database className="w-4 h-4" />
                                <span>{model.data_scope === 'project' ? '프로젝트 데이터' : '컬렉션 데이터'}</span>
                            </div>
                            <div className="flex items-center gap-1.5 bg-zinc-50 px-3 py-1.5 rounded-lg">
                                <Layers className="w-4 h-4" />
                                <span>{model.task_type}</span>
                            </div>
                        </div>
                    </div>

                    {/* Real-time Progress (SSE) */}
                    {model.progress_status === "RUNNING" && (
                        <div className="bg-white rounded-2xl p-6 border border-blue-100 shadow-sm">
                            <h3 className="text-lg font-bold text-zinc-900 mb-4 flex items-center gap-2">
                                <Activity className="w-5 h-5 text-blue-500" />
                                실시간 학습 진행률
                            </h3>
                            <ModelProgressSSE targetId={model.id} initialProgress={model.progress} />
                        </div>
                    )}

                    {/* Basic Info Accordion */}
                    <div className="bg-white rounded-2xl border border-zinc-200 shadow-sm overflow-hidden">
                        <button
                            onClick={() => setShowBasicInfo(!showBasicInfo)}
                            className="w-full flex items-center justify-between p-6 bg-gradient-to-r from-slate-50 to-white hover:bg-slate-50 transition-colors"
                        >
                            <div className="flex items-center gap-3">
                                <div className="p-2 bg-blue-100 rounded-lg text-blue-600">
                                    <FileBarChart2 className="w-5 h-5" />
                                </div>
                                <span className="text-lg font-bold text-zinc-800">기본 성능 지표</span>
                            </div>
                            {showBasicInfo ? <ChevronUp className="text-zinc-400" /> : <ChevronDown className="text-zinc-400" />}
                        </button>

                        {showBasicInfo && (
                            <div className="p-8 border-t border-zinc-100">
                                <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                                    {/* Metrics Cards */}
                                    <div className="p-5 rounded-xl bg-slate-50 border border-slate-100">
                                        <p className="text-sm font-semibold text-slate-500 mb-1">최고 정확도 (Accuracy)</p>
                                        <p className="text-2xl font-bold text-slate-900">
                                            {recentBestAccuracy !== null ? `${(recentBestAccuracy * 100).toFixed(2)}%` : "-"}
                                        </p>
                                        <div className="text-xs text-slate-400 mt-2">Validation Set 기준</div>
                                    </div>

                                    <div className="p-5 rounded-xl bg-slate-50 border border-slate-100">
                                        <p className="text-sm font-semibold text-slate-500 mb-1">총 학습 시간</p>
                                        <p className="text-2xl font-bold text-slate-900">{formatElapsed(model.elapsed_time)}</p>
                                    </div>

                                    <div className="p-5 rounded-xl bg-slate-50 border border-slate-100">
                                        <p className="text-sm font-semibold text-slate-500 mb-1">학습 데이터 수</p>
                                        <p className="text-2xl font-bold text-slate-900">{(model.data_num || 0).toLocaleString()}</p>
                                    </div>

                                    <div className="p-5 rounded-xl bg-slate-50 border border-slate-100">
                                        <p className="text-sm font-semibold text-slate-500 mb-1">총 Epoch</p>
                                        <p className="text-2xl font-bold text-slate-900">{prevEpoch}</p>
                                    </div>
                                </div>

                                <div className="mt-8 pt-6 border-t border-zinc-100">
                                    <h4 className="text-sm font-bold text-zinc-900 mb-4">하이퍼파라미터 설정</h4>
                                    <div className="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
                                        <div><span className="text-zinc-500">Batch Size:</span> <span className="font-mono ml-2">{model.batch_size}</span></div>
                                        <div><span className="text-zinc-500">Learning Rate:</span> <span className="font-mono ml-2">{model.learning_rate}</span></div>
                                        <div><span className="text-zinc-500">Max Length:</span> <span className="font-mono ml-2">{model.max_length}</span></div>
                                        <div><span className="text-zinc-500">레이블 수:</span> <span className="font-mono ml-2">{model.collection_num}</span></div>
                                    </div>
                                </div>
                            </div>
                        )}
                    </div>


                    <ModelRetrainSection
                        model={model}
                        isBusy={isBusy}
                        storeStatus={storeStatus}
                        token={token}
                        onStateChange={setState}
                    />

                    {/* Chart Section */}
                    {lineData.length > 0 && (
                        <div className="grid md:grid-cols-2 gap-6">
                            {/* Accuracy Chart */}
                            <div className="bg-white rounded-2xl border border-zinc-200 shadow-sm p-6">
                                <h3 className="text-lg font-bold text-zinc-900 mb-6 flex items-center gap-2">
                                    <div className="w-1 h-5 bg-emerald-500 rounded-full" />
                                    정확도 그래프 (Accuracy)
                                </h3>
                                <div className="h-64">
                                    <ResponsiveContainer width="100%" height="100%">
                                        <LineChart data={lineData}>
                                            <CartesianGrid strokeDasharray="3 3" vertical={false} stroke="#f1f5f9" />
                                            <XAxis dataKey="epoch" stroke="#94a3b8" tick={{ fontSize: 12 }} />
                                            <YAxis stroke="#94a3b8" tick={{ fontSize: 12 }} domain={[0, 1]} />
                                            <Tooltip contentStyle={{ borderRadius: '12px', border: 'none', boxShadow: '0 4px 6px -1px rgb(0 0 0 / 0.1)' }} />
                                            <Legend />
                                            <Line type="monotone" dataKey="train_acc" stroke="#10b981" strokeWidth={2} dot={false} name="Train Acc" />
                                            <Line type="monotone" dataKey="valid_acc" stroke="#3b82f6" strokeWidth={2} dot={false} name="Valid Acc" />
                                        </LineChart>
                                    </ResponsiveContainer>
                                </div>
                            </div>

                            {/* Loss Chart */}
                            <div className="bg-white rounded-2xl border border-zinc-200 shadow-sm p-6">
                                <h3 className="text-lg font-bold text-zinc-900 mb-6 flex items-center gap-2">
                                    <div className="w-1 h-5 bg-orange-500 rounded-full" />
                                    손실 그래프 (Loss)
                                </h3>
                                <div className="h-64">
                                    <ResponsiveContainer width="100%" height="100%">
                                        <LineChart data={lineData}>
                                            <CartesianGrid strokeDasharray="3 3" vertical={false} stroke="#f1f5f9" />
                                            <XAxis dataKey="epoch" stroke="#94a3b8" tick={{ fontSize: 12 }} />
                                            <YAxis stroke="#94a3b8" tick={{ fontSize: 12 }} />
                                            <Tooltip contentStyle={{ borderRadius: '12px', border: 'none', boxShadow: '0 4px 6px -1px rgb(0 0 0 / 0.1)' }} />
                                            <Legend />
                                            <Line type="monotone" dataKey="train_loss" stroke="#f97316" strokeWidth={2} dot={false} name="Train Loss" />
                                            <Line type="monotone" dataKey="valid_loss" stroke="#ef4444" strokeWidth={2} dot={false} name="Valid Loss" />
                                        </LineChart>
                                    </ResponsiveContainer>
                                </div>
                            </div>
                        </div>
                    )}

                    {/* Used Collections List (Pagination) */}
                    {model.mapping && (
                        <div className="bg-white rounded-2xl border border-zinc-200 shadow-sm overflow-hidden">
                            <button
                                onClick={() => setShowCollectionList(!showCollectionList)}
                                className="w-full flex items-center justify-between p-6 hover:bg-zinc-50 transition-colors"
                            >
                                <span className="font-bold text-zinc-900">사용된 컬렉션 (레이블) 목록</span>
                                <span className="text-sm text-zinc-500">총 {mappingEntries.length}개</span>
                            </button>

                            {showCollectionList && (
                                <div className="p-6 border-t border-zinc-100">
                                    <div className="grid grid-cols-1 md:grid-cols-2 gap-3 mb-6">
                                        {paginatedMapping.map(([k, v], idx) => (
                                            <div key={k} className="flex items-center gap-3 p-3 rounded-xl border border-zinc-100 bg-zinc-50">
                                                <div className="w-8 h-8 rounded-full bg-white border border-zinc-200 flex items-center justify-center text-xs font-bold text-zinc-500">
                                                    {(mappingPage - 1) * ITEMS_PER_PAGE + idx + 1}
                                                </div>
                                                <div className="flex-1 min-w-0">
                                                    <div className="text-xs text-zinc-400">Label</div>
                                                    <div className="text-sm font-medium truncate" title={safeDecode(k)}>{safeDecode(k)}</div>
                                                </div>
                                                <div className="px-2.5 py-1 bg-blue-100 text-blue-700 text-xs font-bold rounded-lg">
                                                    {safeDecode(v)}
                                                </div>
                                            </div>
                                        ))}
                                    </div>

                                    {/* Pagination Controls */}
                                    {totalMappingPages > 1 && (
                                        <div className="flex justify-center gap-2">
                                            <button
                                                onClick={() => setMappingPage(p => Math.max(1, p - 1))}
                                                disabled={mappingPage === 1}
                                                className="p-2 border rounded-lg disabled:opacity-50"
                                            >
                                                <ChevronLeft className="w-4 h-4" />
                                            </button>
                                            <span className="flex items-center px-4 text-sm font-medium">
                                                {mappingPage} / {totalMappingPages}
                                            </span>
                                            <button
                                                onClick={() => setMappingPage(p => Math.min(totalMappingPages, p + 1))}
                                                disabled={mappingPage === totalMappingPages}
                                                className="p-2 border rounded-lg disabled:opacity-50"
                                            >
                                                <ChevronRight className="w-4 h-4" />
                                            </button>
                                        </div>
                                    )}
                                </div>
                            )}
                        </div>
                    )}

                    {/* Inference Section */}
                    <div className="bg-white rounded-2xl border border-zinc-200 shadow-sm p-8">
                        <div className="flex items-center gap-3 mb-6">
                            <div className="p-2 bg-purple-100 rounded-lg text-purple-600">
                                <Upload className="w-5 h-5" />
                            </div>
                            <h2 className="text-xl font-bold text-zinc-900">파일 기반 추론</h2>
                        </div>

                        <div className="bg-blue-50 border border-blue-100 rounded-xl p-4 mb-6 text-sm text-blue-800">
                            💡 <b>CSV, XLSX, JSON</b> 파일을 업로드하여 모델 성능을 테스트할 수 있습니다.
                            첫 번째 행은 반드시 컬럼명이어야 합니다.
                        </div>

                        <FilePreviewEditor onDataParsed={setParsedData} />

                        <div className="mt-6 flex justify-end">
                            <button
                                onClick={handleInferFile}
                                disabled={inferLoading || parsedData.length === 0}
                                className="px-6 py-3 bg-zinc-900 text-white font-bold rounded-xl hover:bg-zinc-800 disabled:opacity-50 disabled:cursor-not-allowed transition-all flex items-center gap-2"
                            >
                                {inferLoading ? (
                                    <>
                                        <div className="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin" />
                                        <span>추론 중...</span>
                                    </>
                                ) : (
                                    <>
                                        <Activity className="w-4 h-4" />
                                        <span>추론 시작</span>
                                    </>
                                )}
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </ProjectLayout>
    );
}